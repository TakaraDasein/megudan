# Dependencias y salidas de build
node_modules/
web/dist/
web/.astro/
.cache/

# npm está prohibido en este repo: un lockfile suyo es un error
package-lock.json
yarn.lock

# Material de origen en resolución completa (~750 MB).
# No entra al repo: se guarda aparte. Lo que el sitio usa ya está
# derivado en web/src/assets/ y web/public/.
assets-origen/
New/

# Sistema
.DS_Store
Thumbs.db
*.log

# Caché de los generadores de herramientas/
__pycache__/

# Skills de agentes instaladas con `pnpm dlx skills add` (GreenSock y demás).
# Son herramienta de quien desarrolla, no del sitio: cada quien instala las
# suyas y no tiene sentido versionarlas junto al proyecto.
.agents/
.claude/
skills-lock.json

# Descargas de los generadores (geoBoundaries). Se versiona el SVG, no la fuente.
herramientas/.cache/
