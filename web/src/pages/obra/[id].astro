---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { enlaceWhatsApp } from '../../data/sitio';

import Cercha from '../../components/ilustraciones/obra/cercha.svg';
import MuroTierra from '../../components/ilustraciones/obra/muro-tierra.svg';
import Basa from '../../components/ilustraciones/obra/basa.svg';
import Arco from '../../components/ilustraciones/obra/arco.svg';
import Capitel from '../../components/ilustraciones/obra/capitel.svg';
import Equis from '../../components/iconos/equis.svg';

/**
 * Ficha de obra.
 *
 * La galería no es un montón: va por tramos, y cada tramo lleva un texto. En
 * las obras fotografiadas durante el proceso los tramos son etapas —del
 * replanteo a la cubierta—; en las que solo hay obra terminada son momentos
 * del recorrido. Quien mira una obra en guadua quiere saber cómo se hizo, y
 * una rejilla de veinte fotos sin pie no lo cuenta.
 *
 * El dibujo de cabecera ocupa la columna que antes quedaba vacía al lado del
 * titular. Es el gesto que define cada obra —la cercha, el arco, el capitel—
 * y se lee antes que la primera fotografía: dice de qué va esto en un segundo.
 *
 * Se talla al abrir la página, con la misma mecánica del calificador: cada
 * gubia escala desde el punto por donde entra el filo, así que el trazo avanza
 * en vez de aparecer. Aquí no lleva `data-entrada` —eso lo revela el scroll y
 * el dibujo está sobre el pliegue—: la animación arranca sola en el primer
 * fotograma, que es lo que hace `backwards`.
 */
export async function getStaticPaths() {
  const proyectos = await getCollection('proyectos');
  return proyectos.map((p) => ({ params: { id: p.id }, props: { p } }));
}

const { p } = Astro.props;
const { Content } = await render(p);
const d = p.data;

const DIBUJOS = {
  cercha: Cercha,
  'muro-tierra': MuroTierra,
  basa: Basa,
  arco: Arco,
  capitel: Capitel,
};
const Dibujo = DIBUJOS[d.ilustracion];

const datos = ([
  ['Tipo', d.tipo],
  ['Ubicación', d.ubicacion],
  ['Año', d.anio?.toString() ?? null],
  ['Área', d.area ? `${d.area} m²` : null],
  ['Sistema', d.sistema],
] as [string, string | null][]).filter((par): par is [string, string] => Boolean(par[1]));

const wa = enlaceWhatsApp(`Hola Megudan, vi ${d.titulo} y quiero algo parecido.`);

/** Índice de la foto que va a todo el ancho dentro de un tramo. */
const anchaEn = (cuantas: number) => (cuantas === 1 || cuantas % 2 === 1 ? 0 : -1);
---

<Base titulo={`${d.titulo} — Megudan`} descripcion={`Obra en guadua: ${d.titulo}.`}>
  <article>
    <header class="contenedor cabecera">
      <div class="identidad">
        <p class="rotulo">Obra construida</p>
        <h1 data-revelar-texto>{d.titulo}</h1>

        <dl class="ficha">
          {datos.map(([k, v]) => (
            <div>
              <dt class="rotulo"><span class="marca" aria-hidden="true">↘</span>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>

        <div class="memoria"><Content /></div>
      </div>

      <div class="dibujo"><Dibujo /></div>
    </header>

    {d.secciones.map((s, n) => (
      <section class="contenedor tramo">
        <div class="apunte" data-entrada>
          <p class="rotulo indice">{String(n + 1).padStart(2, '0')}</p>
          <h2>{s.titulo}</h2>
          <p class="texto">{s.texto}</p>
        </div>

        <div class="fotos" data-entrada>
          {s.fotos.map((img, i) => (
            <figure class:list={[{ ancha: i === anchaEn(s.fotos.length) }]}>
              <button type="button" class="lupa" aria-label={`Ver a pantalla completa: ${s.titulo}`}>
                <Image
                  src={img}
                  alt={`${d.titulo} — ${s.titulo.toLowerCase()}`}
                  widths={[600, 1000, 1600, 2000]}
                  sizes="(max-width: 780px) 100vw, 50vw"
                  loading={n === 0 && i < 2 ? 'eager' : 'lazy'}
                />
              </button>
            </figure>
          ))}
        </div>
      </section>
    ))}

    <!-- Una foto cada vez, sin flechas ni carrusel: quien amplía una foto de
         obra quiere mirar *esa*, y un carrusel invita a pasar de largo. Se
         cierra con la ✕, con Esc o tocando fuera. -->
    <dialog class="visor" data-visor aria-label="Fotografía a pantalla completa">
      <button type="button" class="cerrar" data-cerrar aria-label="Cerrar">
        <Equis />
      </button>
      <img data-visor-foto alt="" />
    </dialog>

    <div class="contenedor cierre">
      <a class="cta boton-accion boton-guadua" href={wa} target="_blank" rel="noopener">Quiero algo parecido</a>
      <a class="volver" href="/#obra">← Toda la obra</a>
    </div>
  </article>
</Base>

<script>
  /**
   * Visor a pantalla completa de las fotos de obra.
   *
   * Va con `<dialog>` nativo y no con una isla: Esc, el atrapado del foco y el
   * fondo los pone el navegador, y aquí no hay estado que compartir con nadie.
   * Una foto cada vez y sin flechas, a propósito —ver el comentario del
   * marcado—.
   *
   * Con ClientRouter el módulo se evalúa una sola vez pero el DOM se sustituye
   * en cada navegación, así que esto se rearma en `astro:page-load`. Los
   * escuchas cuelgan de nodos que el router descarta, de modo que no hay nada
   * que desmontar.
   */
  function armarVisor() {
    const visor = document.querySelector<HTMLDialogElement>('[data-visor]');
    const foto = visor?.querySelector<HTMLImageElement>('[data-visor-foto]');
    if (!visor || !foto) return;

    document.querySelectorAll<HTMLButtonElement>('.lupa').forEach((boton) => {
      boton.addEventListener('click', () => {
        const origen = boton.querySelector('img');
        if (!origen) return;
        // El mismo srcset, pero pidiendo el ancho de la ventana: en la rejilla
        // la foto ocupa media columna y aquí la pantalla entera.
        foto.srcset = origen.srcset;
        foto.sizes = '100vw';
        foto.src = origen.src;
        foto.alt = origen.alt;
        visor.showModal();
        // `showModal` hace inerte el resto de la página pero no le quita la
        // barra de desplazamiento: sin esto se ve una barra viva al lado de
        // una foto que ya cabe entera.
        document.documentElement.style.overflow = 'hidden';
      });
    });

    visor.querySelector('[data-cerrar]')?.addEventListener('click', () => visor.close());

    // Tocar fuera de la foto cierra. El clic en el fondo lo recibe el propio
    // <dialog>, porque la foto y la ✕ son sus hijos.
    visor.addEventListener('click', (e) => {
      if (e.target === visor) visor.close();
    });

    // Al cerrar se suelta la foto: si no, la última ampliada se queda en
    // memoria y se ve un fotograma de la anterior al abrir la siguiente.
    visor.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      foto.removeAttribute('src');
      foto.removeAttribute('srcset');
    });
  }

  document.addEventListener('astro:page-load', armarVisor);
</script>

<style>
  /* Cabecera a dos columnas: los datos a la izquierda, el gesto de la obra a
     la derecha. Por debajo de 900 px el dibujo pasa arriba del titular, donde
     sigue haciendo de portada sin robarle el ancho a la ficha. */
  .cabecera {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    align-items: center;
    gap: var(--e5);
    padding-block: var(--e6) var(--e5);
  }
  h1 { font-size: var(--t-3xl); margin-block: var(--e2) var(--e4); visibility: hidden; }

  .dibujo { color: var(--cruda); }
  .dibujo :global(svg) { width: 100%; height: auto; display: block; }

  /* El tallado. Mismo gesto y mismo ritmo que el visor del calificador: 22 ms
     por gubia, y solo `transform`, que no toca layout. */
  .dibujo :global(.gu) {
    transform-box: view-box;
    transform-origin: var(--x, 50%) var(--y, 50%);
    animation: tallar 0.34s cubic-bezier(0.3, 0.9, 0.4, 1) backwards;
    animation-delay: calc(var(--i) * 22ms);
  }
  /* Una masa no se abre con el filo: se entinta. */
  .dibujo :global(.gu.masa) { animation-name: entintar; }

  /* En la primera carga del documento el splash tapa la página más de lo que
     dura el tallado, así que sin esto el dibujo se talla entero por detrás del
     velo y el visitante llega a una ficha ya puesta —el mismo problema que
     resuelve a mano la obertura de la portada—. El velo borra el atributo al
     retirarse y el tallado arranca ahí. En las navegaciones por dentro del
     sitio el atributo no existe y esto no hace nada. */
  :global(html[data-splash='abierto']) .dibujo :global(.gu) {
    animation-play-state: paused;
  }

  @keyframes tallar {
    from { transform: rotate(var(--a)) scaleX(0) rotate(calc(-1 * var(--a))); }
    to   { transform: rotate(var(--a)) scaleX(1) rotate(calc(-1 * var(--a))); }
  }
  @keyframes entintar {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Ficha como lista de especificaciones: una fila por dato, regla fina debajo. */
  .ficha { max-width: 46ch; margin-bottom: var(--e4); }
  .ficha > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--e3);
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }
  .ficha dt { display: flex; align-items: baseline; gap: 0.6rem; }
  .marca { color: var(--estructura); }
  .ficha dd { color: var(--tx); text-align: right; }

  .memoria { max-width: 62ch; color: var(--tx2); }
  .memoria :global(p) { margin-bottom: var(--e2); }
  .memoria:empty { display: none; }

  /* Un tramo: el apunte queda fijo al costado mientras pasan sus fotografías,
     que es lo que mantiene el texto a la vista en los tramos largos. */
  .tramo {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1fr);
    align-items: start;
    gap: var(--e5);
    padding-block: var(--e4);
  }
  .apunte { position: sticky; top: var(--e5); }
  .indice { color: var(--estructura); }
  .apunte h2 {
    font-family: var(--disp);
    font-size: var(--t-xl);
    margin-block: var(--e1) var(--e2);
  }
  .texto { color: var(--tx2); max-width: 42ch; }

  .fotos { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--e3); }
  .fotos figure.ancha { grid-column: 1 / -1; }
  /* El marco va en el café guadua del dibujo de cabecera, no en la línea
     genérica: encuadra la fotografía con el mismo color con el que está
     tallada la ilustración de arriba, y las dos mitades de la ficha se leen
     como una sola pieza. */
  .fotos :global(img) {
    width: 100%;
    height: auto;
    border: 1px solid var(--cruda);
    border-radius: var(--borde);
  }

  /* El botón no se ve: la foto es el botón. Solo cambia el cursor y responde
     al foco de teclado, que es lo que faltaba cuando la foto era inerte. */
  .lupa {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: var(--borde);
  }
  .lupa:focus-visible { outline: 2px solid var(--accion-tx); outline-offset: 3px; }

  /* --- visor --- */
  /* La foto se escala para caber entera, sin nada que desplazar. Los límites
     van sobre la imagen y el diálogo se queda sin padding: con padding la caja
     mide la ventana *más* el relleno —el <dialog> no hereda border-box— y lo
     que sobra se recorta por abajo. */
  .visor {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    overflow: hidden;
  }
  .visor::backdrop { background: rgb(12 15 9 / 0.94); }
  .visor[open] {
    display: grid;
    place-items: center;
  }
  .visor img {
    max-width: min(94vw, 1800px);
    max-height: 90dvh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid var(--cruda);
    border-radius: var(--borde);
    cursor: zoom-out;
  }

  .cerrar {
    position: fixed;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--cruda);
    background: rgb(29 35 22 / 0.75);
    border: 1px solid var(--line);
    border-radius: var(--borde);
    cursor: pointer;
  }
  .cerrar :global(svg) { width: 24px; height: 24px; display: block; }
  .cerrar:hover { color: var(--accion-tx); border-color: var(--accion-tx); }

  /* Al acercar el cursor, los dos tajos tiemblan como el pulso de la mano que
     sostiene la gubia. Van desfasados —un filo no se mueve a la vez que el
     otro— y el recorrido es de grado y medio: más que eso deja de leerse como
     pulso y parece que el icono se rompe. */
  .cerrar :global(.gu) {
    transform-box: view-box;
    transform-origin: 24px 24px;
  }
  .cerrar:hover :global(.gu),
  .cerrar:focus-visible :global(.gu) {
    animation: pulso-gubia 0.34s ease-in-out infinite alternate;
  }
  .cerrar:hover :global(.gu:last-of-type),
  .cerrar:focus-visible :global(.gu:last-of-type) { animation-delay: 0.12s; }

  @keyframes pulso-gubia {
    from { transform: rotate(-1.5deg) translate(-0.3px, 0.3px); }
    to   { transform: rotate(1.5deg) translate(0.3px, -0.3px); }
  }
  .cerrar:focus-visible { outline: 2px solid var(--accion-tx); outline-offset: 2px; }

  .cierre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e3);
    padding-block: var(--e5) var(--e6);
  }
  /* Ver `.boton-accion` en global.css: aquí solo el cuerpo y el relleno. */
  .cta {
    font-size: var(--t-lg);
    padding-block: 1rem;
  }
  .volver {
    font-family: var(--mono);
    font-size: var(--t-sm);
    color: var(--tx3);
    text-decoration: none;
    /* Destino táctil de 44 px: es el único camino de vuelta de la ficha y en
       celular caía justo al lado del botón flotante. */
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 900px) {
    .cabecera { grid-template-columns: 1fr; gap: var(--e4); padding-block: var(--e5) var(--e4); }
    .cabecera .dibujo { order: -1; max-width: 380px; }
    .tramo { grid-template-columns: 1fr; gap: var(--e3); }
    .apunte { position: static; }
  }
  @media (max-width: 780px) { .fotos { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: reduce) {
    h1 { visibility: visible; }
    /* El dibujo entero, ya tallado, desde el primer fotograma. */
    .dibujo :global(.gu) { animation: none; }
    .cerrar:hover :global(.gu),
    .cerrar:focus-visible :global(.gu) { animation: none; }
  }
</style>
