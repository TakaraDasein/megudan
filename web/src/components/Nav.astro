---
import { getImage } from 'astro:assets';
import { sitio } from '../data/sitio';
import IconoWhatsApp from './iconos/WhatsApp.astro';
import acopio from '../assets/texturas/acopio-culmos.jpg';

// Los enlaces de ancla se resuelven contra la portada para que el menú también
// funcione desde /comprar-guadua y desde las fichas de obra.
//
// `precarga` solo la lleva el que va a otra página; las anclas no tienen nada
// que traer. Y es `load` y no la estrategia implícita del `<ClientRouter />`
// —`hover`—, que empieza a descargar cuando el cursor ya está encima: para
// cuando el visitante pulsa, la descarga va a medias. Con `load` el HTML está
// en caché desde que la página en la que estás terminó de cargar.
//
// Importa sobre todo en las fichas de obra, que son las únicas páginas sin
// ConmutadorRama —él ya pide su rama contraria con `load`— y donde este menú es
// el único camino al material. El prefetch deduplica por URL, así que en la
// portada, donde conviven los dos, sigue siendo una sola descarga.
const secciones = [
  { href: '/#servicios', texto: 'Servicios', alFinalEnMovil: true },
  { href: '/#obra', texto: 'Obra' },
  { href: '/#comprar', texto: 'Comprar guadua' },
];

/* En el desplegable de celular «Servicios» baja al final. El panel ocupa la
   pantalla entera y el primer renglón es el que cae bajo el pulgar, así que
   ahí conviene lo que lleva a una conversación —la obra y el material— y no el
   índice de lo que hacemos. En escritorio el orden no cambia: allí los tres
   se ven de una sola mirada y manda el orden de lectura de la página.

   Se deriva de la misma lista para no tener dos que mantener; `sort` es
   estable, así que el resto conserva su orden. */
const seccionesMovil = [...secciones].sort(
  (a, b) => Number(a.alFinalEnMovil ?? false) - Number(b.alFinalEnMovil ?? false),
);
/* «Hablemos» no abre WhatsApp de una: lleva al calificador, que es donde se
   arma el mensaje ya calificado. Esa es la razón de ser del embudo —si el botón
   saltara directo al chat, la conversación empezaría en blanco.
   El ancla se resuelve contra la página que sí tiene calificador: /comprar-guadua
   tiene el suyo y las fichas de obra no tienen ninguno, así que caen en el de
   la portada. */
const ruta = Astro.url.pathname;
const enSuPagina = ruta === '/comprar-guadua' || ruta === '/comprar-guadua/' || ruta === '/';
const alCalificador = enSuPagina ? '#calificador' : '/#calificador';

/* El menú es la tercera puerta a la rama de compra, además del conmutador de la
   portada, y sin marca de estado ofrecía ir a la página en la que ya estás. Se
   marca la actual con `aria-current="page"` —que es lo que el lector de
   pantalla anuncia— y con el mismo color que usa el conmutador para su rama
   activa, para que las dos piezas digan lo mismo.
   Solo las rutas, no las anclas: cuál de las secciones de la portada estás
   mirando lo decide el desplazamiento, no el servidor. */
const esActual = (href: string) =>
  !href.includes('#') && (ruta === href || ruta === `${href}/`);

/* La fotografía de portada de /comprar-guadua, adelantada desde las fichas de
   obra.

   `data-astro-prefetch="load"` en el enlace trae el DOCUMENTO, no sus
   subrecursos: llegando desde una ficha el HTML está instantáneo pero la foto
   empieza a pedirse recién ahí, y con el cruce nuevo la página entra desde la
   derecha todavía en blanco. En las dos ramas esto ya lo resuelve
   ConmutadorRama.astro, que adelanta la rama contraria en tiempo ocioso; las
   fichas de obra son las únicas páginas sin conmutador, y este menú su único
   camino al material.

   Mismos `widths`/`sizes`/`format` que el `<Image>` de HeroCompra.astro, o el
   navegador elegiría una variante distinta y la descarga no serviría de nada. */
const enRama = enSuPagina;
const fondoMaterial = enRama
  ? undefined
  : (await getImage({ src: acopio, widths: [900, 1600, 2200], sizes: '100vw', format: 'webp' }))
      .srcSet.attribute;
---

<header class="nav" data-nav data-fondo-material={fondoMaterial}>
  <div class="contenedor fila">
    <!-- El logo vive en public/ y no en src/assets: es la excepción a la regla
         de <Image>. No hay copias duplicadas que Astro deba deduplicar, y así el
         SVG se descarga y cachea una sola vez en lugar de incrustar sus 466
         trazos de xilografía en el HTML de cada página. -->
    <a href="/" class="marca" aria-label={`${sitio.nombreLargo} — inicio`}>
      <img src="/marca/logo.svg" alt={sitio.nombreLargo} width="752" height="287" />
    </a>

    <nav class="desktop" aria-label="Secciones">
      <ul>
        {secciones.map((s) => (
          <li>
            <a
              href={s.href}
              aria-current={esActual(s.href) ? 'page' : undefined}
              data-astro-prefetch={s.precarga}
            >{s.texto}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Menú de celular. Va en `<details>` y no en un botón con estado: el
         navegador ya sabe abrir y cerrar, funciona sin JavaScript, y el
         ClientRouter lo devuelve cerrado en cada navegación porque sustituye
         el DOM. Sin él, por debajo de 780 px el sitio se quedaba sin ninguna
         navegación: solo el logo y el botón flotante. -->
    <details class="menu" data-menu>
      <summary aria-label="Menú de secciones">
        <span class="barras" aria-hidden="true"></span>
      </summary>
      <nav class="panel" aria-label="Secciones">
        <ul>
          {seccionesMovil.map((s) => (
            <li>
              <a
              href={s.href}
              aria-current={esActual(s.href) ? 'page' : undefined}
              data-astro-prefetch={s.precarga}
            >{s.texto}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>

    <!-- El rótulo dice «Hablemos» y quien pone el canal es el icono. El
         `aria-label` sí lo nombra: sin él, el lector de pantalla anuncia un
         enlace que no dice a dónde lleva. -->
    <a
      class="wa boton-accion boton-guadua"
      href={alCalificador}
      aria-label="Hablemos: cuéntanos tu idea y seguimos por WhatsApp"
    >
      <IconoWhatsApp />
      Hablemos
    </a>
  </div>
</header>

<!-- En celular el contacto vive abajo, al alcance del pulgar. -->
<a
  class="wa-flotante boton-accion flotante boton-guadua"
  href={alCalificador}
  aria-label="Hablemos: cuéntanos tu idea y seguimos por WhatsApp"
>
  <IconoWhatsApp tam={20} />
  Hablemos
</a>

<script is:inline>
  /* Un ancla de la misma página no sustituye el DOM —el ClientRouter no
     interviene—, así que el panel se quedaría abierto encima de la sección a la
     que acaba de saltar. Se cierra a mano. Delegado en `document` y `is:inline`
     para que siga vivo después de cada navegación. */
  if (!window.__megudanMenu) {
    window.__megudanMenu = true;
    document.addEventListener('click', (e) => {
      const enlace = e.target.closest?.('[data-menu] a');
      if (enlace) enlace.closest('[data-menu]').open = false;
    });
  }

  /* La foto de portada del material, adelantada en tiempo ocioso. El atributo
     solo lo emiten las páginas que no son ninguna de las dos ramas —las fichas
     de obra—, así que aquí no hay nada que decidir: si está, se precarga.

     En tiempo ocioso y no en `load` a secas: así no compite con la fotografía
     de portada de la ficha en la que estás, que es su LCP.
     `requestIdleCallback` no está en todos los navegadores; el `setTimeout`
     cubre el resto.

     Comparte el registro con ConmutadorRama.astro —mismo `window.__megudanPrecargaRama`—
     para que al cruzar a una rama y volver no se vuelva a pedir. */
  if (!window.__megudanPrecargaMaterial) {
    window.__megudanPrecargaMaterial = true;
    window.__megudanPrecargaRama = window.__megudanPrecargaRama || new Set();

    const adelantarMaterial = () => {
      const alOcio = window.requestIdleCallback || ((fn) => setTimeout(fn, 1200));
      alOcio(() => {
        const nav = document.querySelector('[data-fondo-material]');
        const conjunto = nav && nav.dataset.fondoMaterial;
        if (!conjunto || window.__megudanPrecargaRama.has(conjunto)) return;
        window.__megudanPrecargaRama.add(conjunto);
        const enlace = document.createElement('link');
        enlace.rel = 'preload';
        enlace.as = 'image';
        enlace.imageSrcset = conjunto;
        enlace.imageSizes = '100vw';
        document.head.appendChild(enlace);
      });
    };
    adelantarMaterial();
    document.addEventListener('astro:page-load', adelantarMaterial);
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    transition: background 0.3s, border-color 0.3s, box-shadow 0.3s;
  }
  /* Despegada: el contenido pasa por debajo, no al lado.

     EL NAV NO CAMBIA DE ALTO, y eso no es una simplificación: es lo que impide
     que vibre. `navCompacta` (motion.ts) no tiene `trigger` —mide el
     desplazamiento de la ventana—, así que si su clase encogiera el nav
     cambiaría el alto del documento y con él el desplazamiento máximo. Cerca
     del umbral eso se muerde la cola: encoge, el scroll se recoloca, deja de
     cumplirse la condición, crece, vuelve a cumplirse. Con la transición de
     0,3 s en medio se ve como un temblor. Llegó a tener `min-height: 54px` y el
     logo a 26 px; ahí estaba el problema.

     Color, sombra y borde son gratis porque no tocan el flujo. Cualquier cosa
     que cambie el alto, no. */
  .nav.compacta {
    background: color-mix(in srgb, var(--bg) 96%, transparent);
    border-bottom-color: var(--line2);
    box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.65);
  }
  .fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e3);
    min-height: 68px;
  }
  .marca { display: flex; align-items: center; text-decoration: none; }
  /* 34px es lo más bajo a lo que el lockup completo sigue leyéndose: por debajo,
     la línea «CONSTRUCCIONES» se cierra. */
  .marca img { display: block; height: 34px; width: auto; }

  nav ul { list-style: none; display: flex; gap: var(--e4); }
  /* El relleno vertical no es aire: es el objetivo de pulsación. El renglón de
     texto mide 17 px y la norma pide 24 como mínimo (WCAG 2.5.8); con
     `padding-block` la caja llega a 33 sin mover nada de sitio, porque el menú
     ya está centrado por `align-items` y el nav tiene alto fijo.
     El hueco entre enlaces se compensa con un margen negativo del mismo valor,
     o el relleno los separaría más de la cuenta. */
  nav a {
    display: inline-block;
    padding-block: 0.5rem;
    margin-block: -0.5rem;
    font-size: var(--t-sm);
    color: var(--tx3);
    text-decoration: none;
    transition: color 0.2s;
  }
  nav a:hover { color: var(--tx); }
  /* La rama en la que ya estás. Mismo tratamiento que la rama activa del
     conmutador —texto a plena luz— para que las dos piezas del sitio que
     señalan «estás aquí» lo digan igual. Sin subrayado ni color nuevo: el
     naranja es la acción y esto no es una acción, es un estado. */
  nav a[aria-current='page'] { color: var(--tx); }

  .wa {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--disp);
    font-weight: 600;
    font-size: var(--t-sm);
    color: var(--accion-tx);
    border: 1px solid var(--accion-honda);
    padding-block: 0.6rem;
    border-radius: var(--borde);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }
  /* Sin relleno al apuntarlo: lo hace `.boton-accion` en global.css, y lo hace
     igual que el resto de acciones del sitio —crece, aprieta el filo—. Antes
     este era el único que se rellenaba de naranja macizo bajo el cursor. */

  .wa-flotante { display: none; }
  .menu { display: none; }

  @media (max-width: 780px) {
    nav.desktop, .wa { display: none; }

    /* --- MENÚ DE CELULAR ---
       El disparador mide 44 px: es el mínimo con el que un pulgar acierta sin
       apuntar, y por debajo de eso el logo y el menú quedaban a distancia de
       error uno del otro. */
    /* El lockup mide 34 px de alto y como destino táctil se quedaba corto:
       el enlace se estira a 44 sin mover el dibujo. */
    .marca { min-height: 44px; }

    .menu { display: block; position: relative; }
    .menu summary {
      list-style: none;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      margin-right: -0.5rem;
      cursor: pointer;
      border-radius: var(--borde);
    }
    .menu summary::-webkit-details-marker { display: none; }
    /* Tres barras dibujadas con el borde y las sombras del propio trazo: el
       icono es una sola caja y no tres nodos. */
    .barras,
    .barras::before,
    .barras::after {
      content: '';
      display: block;
      width: 22px;
      height: 1.5px;
      background: var(--tx);
      transition: transform 0.25s, opacity 0.2s;
    }
    .barras { position: relative; }
    .barras::before { position: absolute; top: -7px; }
    .barras::after { position: absolute; top: 7px; }
    /* Abierto, las barras se cruzan: el mismo control cierra. */
    .menu[open] .barras { background: transparent; }
    .menu[open] .barras::before { transform: translateY(7px) rotate(45deg); }
    .menu[open] .barras::after { transform: translateY(-7px) rotate(-45deg); }

    /* El panel cuelga de la barra y ocupa el ancho de la ventana: en un celular
       un desplegable estrecho a la derecha obliga a apuntar. */
    .panel {
      position: absolute;
      top: calc(100% + 0.75rem);
      right: calc(-1 * var(--gutter));
      width: 100vw;
      max-width: 100vw;
      /* Opaco, no velado: el panel cae sobre la portada, y con el titular
         asomando por detrás los tres renglones dejan de leerse como una lista
         y empiezan a leerse como parte de la fotografía. */
      background: var(--bg);
      border-block: 1px solid var(--line);
      padding: var(--e2) var(--gutter) var(--e3);
    }
    .panel ul { list-style: none; display: grid; }
    .panel li + li { border-top: 1px solid var(--line); }
    .panel a {
      display: block;
      /* Renglón completo: el destino táctil es la fila, no las letras. */
      padding-block: 1.15rem;
      font-family: var(--disp);
      font-weight: 600;
      /* Cuerpo de titular, no de menú. El panel ocupa la pantalla entera y solo
         tiene tres destinos: a cuerpo de texto se leían como una lista de pie de
         página. Centrados, además, se apunta con el pulgar sin cruzar el ancho
         del teléfono. */
      font-size: 1.5rem;
      line-height: 1.25;
      letter-spacing: -0.02em;
      text-align: center;
      color: var(--tx);
      text-decoration: none;
    }

    /* Reserva la franja del botón flotante en toda la página, no solo en el
       hero: si no, tapa el último control enfocado de cualquier sección.
       El `env()` añade la barra gestual del teléfono, que en iOS se come otro
       tanto por debajo. */
    :global(body) { padding-bottom: calc(4.75rem + env(safe-area-inset-bottom)); }
    .wa-flotante {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      position: fixed;
      inset-inline: var(--gutter);
      bottom: calc(var(--e2) + env(safe-area-inset-bottom));
      z-index: 60;
      text-align: center;
      padding-block: 0.95rem;
      /* La transformada la lleva `.boton-accion`; aquí solo se anima la
         retirada del botón, que es opacidad. Declararla también en `transform`
         desde este lado pisaba el `scale` del `:active`. */
      transition: opacity 0.3s ease;
    }
    /* Dentro del calificador el botón se retira: ahí el visitante ya está en el
       embudo y su propio «Abrir WhatsApp» es el que manda. Dos llamadas
       naranjas en la misma pantalla se disputan el pulgar, y la flotante
       encima tapa la última pregunta. */
    :global(body.en-calificador) .wa-flotante {
      transform: translateY(calc(100% + var(--e3)));
      opacity: 0;
      pointer-events: none;
    }
  }
</style>
