---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import porDefecto from '../assets/proyectos/casa-anolaima/casa-anolaima-01.jpg';

/**
 * Modelo que gira sobre sí mismo, dibujado fotograma a fotograma.
 *
 * Los fotogramas viven en `public/modelo-360/` y se numeran desde 000. Si aún
 * no hay ninguno, el componente muestra una fotografía de obra: la sección
 * funciona igual y no queda un hueco esperando un archivo.
 *
 * Con `arrastre` el giro lo lleva el visitante: basta con mover el cursor por
 * la sección, sin pulsar; en reposo se queda quieto. Sin `arrastre` gira solo,
 * a `vuelta` segundos por vuelta.
 *
 * EL GIRO AUTOMÁTICO ESTUVO DESCARTADO, y conviene saber por qué dejó de
 * estarlo. Con 36 fotogramas cada paso son 10°, y a una velocidad pausada eso
 * se ve escalonado; suavizarlo pedía fundir fotogramas, que emborrona el
 * modelo. Lo que lo desbloqueó no fue animarlo mejor sino cambiar la fuente:
 * `sumak` se rehízo a 72 fotogramas —5° por paso— aprovechando que el encuadre
 * iba a 1275 px cuando el hero solo enseña 470 px CSS. Más fotogramas y menos
 * resolución, al mismo peso.
 *
 * Los otros dos modelos siguen a 36 y vienen de video, así que NO les pongas
 * giro automático lento sin rehacerlos: se verán a tirones.
 *
 * CUATRO ENTRADAS PERO TRES EDIFICIOS. `modelo` elige cuál:
 *
 * · `sumak` — el kiosco del Restaurante Sumak: cinco conos de guadua con
 *   cubierta de paja sobre basas de concreto. Es el del hero, y el único
 *   renderizado aquí (`herramientas/render-kiosco-360.py`, desde el modelo de
 *   Revit) en vez de sacado de un video generado.
 * · `sumak-calido` — EL MISMO EDIFICIO con otra luz, no otro kiosco. Es la
 *   versión anterior del render, más contrastada y más cálida, y existe porque
 *   los dos sitios donde aparece el kiosco tienen fondos muy distintos: el hero
 *   va sobre una fotografía clara y pide la luz pareja de `sumak`, mientras el
 *   guadual es una escena oscura y virada al verde donde esa misma luz se
 *   apagaba. Ahí la versión cálida se sostiene mejor.
 *   Va a 36 pasos y no a 72: en el guadual el giro lo lleva el cursor, y con la
 *   mano encima 10° por paso no se notan. La mitad de fotogramas, la mitad de
 *   bytes.
 * · `teja` — el octogonal de teja de barro con barandas.
 * · `paja` — el cónico de techo de paja y columnas en celosía.
 *
 * OJO CON EL NOMBRE `teja`: hasta hace poco apuntaba a `/modelo-360/`, que es
 * donde vive el kiosco Sumak, así que nombraba un edificio y servía otro. Si
 * algo del sitio pide `teja` esperando el del hero, está desactualizado.
 *
 * Van en dos `import.meta.glob` y no en uno con la ruta armada, porque el glob
 * de Vite se resuelve al compilar y no acepta una ruta que dependa de un prop:
 * con una variable dentro no encuentra nada y el componente cae al respaldo sin
 * decir por qué. Dos globs literales y un objeto que elige.
 *
 * `vaiven` sigue en `true` POR EL MODELO `paja`, no por los dos. Sus fotogramas
 * salen de un video generado que oscila en vez de orbitar (ver
 * `contenido/PROMPT-modelo-360.md`), así que el último no empalma con el primero
 * y el bucle se cortaba; recorriéndolos de ida y de vuelta el giro es continuo.
 *
 * `teja` ya NO lo necesita y el hero lo apaga. Sus fotogramas son un turntable
 * de verdad —36 pasos de 10° renderizados en Blender desde el modelo de Revit
 * con `herramientas/render-kiosco-360.py`—, y en una vuelta que cierra sola el
 * vaivén se lee como un péndulo. Cuando `paja` se rehaga igual, este valor por
 * omisión debería pasar a `false` y desaparecer de las llamadas.
 */
interface Props {
  modelo?: 'sumak' | 'sumak-calido' | 'teja' | 'paja';
  arrastre?: boolean;
  /** Segundos por vuelta cuando gira solo. Sin `arrastre` no hace nada. */
  vuelta?: number;
  /**
   * Muestra los mandos del giro —pausa, sentido y velocidad— en una barra
   * discreta al pie del modelo. Solo con giro automático: gobiernan el bucle,
   * y el visor de arrastre no tiene bucle que gobernar.
   */
  mandos?: boolean;
  /**
   * Funde cada fotograma con el siguiente en lugar de saltar de uno a otro.
   * Es lo que hace que un giro lento se vea continuo. SOLO con secuencias de
   * paso corto —`sumak`, que va a 72 pasos de 5°—: a 36 pasos, fundir dos
   * vistas separadas 10° deja el modelo doble.
   */
  fundido?: boolean;
  vaiven?: boolean;
  pie?: string;
  respaldo?: ImageMetadata;
  alt?: string;
  relacion?: string;
}
const {
  modelo = 'sumak',
  arrastre = false,
  vuelta,
  mandos = false,
  fundido = false,
  vaiven = true,
  pie = 'Modelo estructural · gira solo',
  respaldo = porDefecto,
  alt = 'Estructura en guadua de un segundo piso: columnas, vigas y cerchas',
  relacion = '4 / 3',
} = Astro.props;

const MODELOS = {
  sumak: {
    ruta: '/modelo-360/modelo-',
    fotogramas: Object.keys(import.meta.glob('/public/modelo-360/modelo-*.webp', { eager: true })),
  },
  'sumak-calido': {
    ruta: '/modelo-360-calido/modelo-',
    fotogramas: Object.keys(import.meta.glob('/public/modelo-360-calido/modelo-*.webp', { eager: true })),
  },
  teja: {
    ruta: '/kiosco-teja-360/teja-',
    fotogramas: Object.keys(import.meta.glob('/public/kiosco-teja-360/teja-*.webp', { eager: true })),
  },
  paja: {
    ruta: '/kiosco-paja-360/paja-',
    fotogramas: Object.keys(import.meta.glob('/public/kiosco-paja-360/paja-*.webp', { eager: true })),
  },
} as const;

const elegido = MODELOS[modelo];
const TOTAL = elegido.fotogramas.length;
---

{TOTAL > 0 ? (
  <div
    class:list={['giratorio', { arrastrable: arrastre }]}
    data-giratorio={arrastre ? undefined : true}
    data-giratorio-arrastre={arrastre ? true : undefined}
    data-total={TOTAL}
    data-ruta={elegido.ruta}
    data-vaiven={vaiven ? true : undefined}
    data-vuelta={!arrastre && vuelta ? vuelta : undefined}
    data-fundido={!arrastre && fundido ? true : undefined}

    style={`--relacion: ${relacion}`}
  >
    <canvas data-lienzo aria-hidden="true"></canvas>

    {!arrastre && mandos && (
      /* LOS MANDOS, al pie del modelo y en voz baja.

         Van casi transparentes y suben al pasar el cursor por el visor. El
         modelo gira solo y eso ya es la propuesta; los mandos son para quien
         quiera pararlo a mirar una unión, así que estorban si piden atención
         antes de que nadie los busque. El `:focus-within` los sube también
         para quien llega con el tabulador, que no tiene cursor que acercar.

         Tres y no más: pausar, invertir y la marcha. Cada uno hace algo que no
         se puede hacer de otro modo. */
      <div class="mandos" data-mandos>
        <button type="button" data-mando="giro" aria-pressed="false" aria-label="Pausar el giro">
          {/* Los dos iconos están siempre en el marcado y el CSS enseña uno
              según `aria-pressed`: así el estado se declara una sola vez, en
              el atributo que además es el que lee el lector de pantalla. */}
          <svg class="ic ic-pausa" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M9 5v14M15 5v14" fill="none" stroke="currentColor"
                  stroke-width="1.8" stroke-linecap="round" />
          </svg>
          <svg class="ic ic-girar" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M8 5l11 7-11 7z" fill="currentColor" />
          </svg>
        </button>

        <button type="button" data-mando="sentido" aria-label="Invertir el sentido del giro">
          <svg class="ic" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M4 9h11a4 4 0 0 1 0 8H9M4 9l3.5-3.5M4 9l3.5 3.5" fill="none"
                  stroke="currentColor" stroke-width="1.8"
                  stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <button type="button" data-mando="ritmo" aria-label="Velocidad del giro">
          {/* Lo que se ve antes de que corra el guion; en cuanto arranca, lo
              reescribe él con la marcha de verdad. Ver `RITMOS` en motion.ts. */}
          <span data-rotulo-ritmo>1.3×</span>
        </button>
      </div>
    )}

    {/* Sin rótulo no se pinta el párrafo. Dejarlo vacío metía una caja de una
        línea de alto en la esquina, que en el visor con mandos empujaba el
        tope de ancho del pie y dejaba un hueco muerto sin nada dentro. */}
    {pie && (arrastre ? <p class="rotulo pie bajo">{pie}</p> : <p class="rotulo pie">{pie}</p>)}
  </div>
) : (
  <figure class="respaldo">
    <Image
      src={respaldo}
      alt={alt}
      widths={[500, 900, 1400]}
      sizes="(max-width: 900px) 100vw, 45vw"
      loading="lazy"
    />
    <figcaption class="rotulo">{pie}</figcaption>
  </figure>
)}

<style>
  .giratorio {
    position: relative;
    width: 100%;
    aspect-ratio: var(--relacion, 4 / 3);
  }
  .giratorio canvas { width: 100%; height: 100%; display: block; }

  /* Con mandos la proporción se muda del contenedor al lienzo: si se quedara
     en el contenedor, la fila de abajo se saldría de la caja y pisaría lo que
     venga después. */
  .arrastrable { aspect-ratio: auto; }
  .arrastrable canvas { height: auto; aspect-ratio: var(--relacion, 4 / 3); }

  /* `pan-y` y no `none`: el navegador conserva el desplazamiento vertical y
     nosotros nos quedamos el horizontal, que es el único eje que gira el
     modelo. Con `none` —que es como estaba— el lienzo se tragaba el gesto
     entero y la portada no se podía desplazar con el dedo encima del kiosco,
     que en celular es media pantalla. La decisión del eje la remata
     `motion.ts`, que solo agarra el dedo si sale de lado. */
  .arrastrable canvas { cursor: grab; touch-action: pan-y; }
  .arrastrable canvas:active { cursor: grabbing; }
  /* Deja libre la esquina derecha, que es de los mandos: sin el tope, un pie
     largo pasa por debajo de ellos y las dos cosas se leen encimadas. */
  .pie {
    position: absolute;
    left: 0;
    bottom: 0;
    max-width: calc(100% - 7.5rem);
    color: var(--tx4);
  }

  /* Con arrastre el rótulo sale del flujo absoluto y baja al pie del bloque,
     centrado bajo el modelo. Va separado de verdad —no pegado al dibujo— para
     que se lea como una indicación al margen y no como parte de la imagen. */
  .pie.bajo {
    position: static;
    text-align: center;
    padding-top: var(--e3);
  }

  /* --- MANDOS DEL GIRO ---------------------------------------------------- */

  /* AL PIE Y EN VOZ BAJA, enfrente del rótulo. El rótulo dice qué es esto y
     ocupa la esquina izquierda; los mandos dicen qué se puede hacer con ello y
     ocupan la derecha, en la misma línea. Puestos en cualquier otro sitio se
     leían como una capa pegada encima de la fotografía.

     Casi transparentes en reposo: el modelo gira solo y eso ya es la
     propuesta. Quien quiera pararlo a mirar una unión los encuentra al acercar
     el cursor; quien no, no tiene por qué verlos. */
  .mandos {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 3;
    display: flex;
    gap: 2px;
    opacity: 0.3;
    transition: opacity 0.3s ease;
  }

  /* «Cerca» es el visor entero, no los botones. Esperar a estar encima de uno
     obliga a apuntar a algo que casi no se ve, que es la pescadilla de siempre
     con los mandos ocultos. Con el cursor en cualquier parte del modelo ya
     están a la vista. `:focus-within` hace lo mismo para el tabulador, que no
     tiene cursor que acercar. */
  .giratorio:hover .mandos,
  .giratorio:focus-within .mandos {
    opacity: 1;
  }

  .mandos button {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    padding: 0;
    border: 0;
    border-radius: calc(var(--borde) - 4px);
    background: none;
    color: var(--tx);
    font: inherit;
    font-family: var(--mono, inherit);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    cursor: pointer;
    /* Sobre la fotografía del guadual, un icono claro sin sombra se pierde en
       cuanto pasa por encima de una caña iluminada. */
    filter: drop-shadow(0 1px 3px rgb(0 0 0 / 0.8));
  }
  .mandos button:hover { background: color-mix(in srgb, var(--tx) 16%, transparent); }
  .mandos button:focus-visible { outline: 2px solid var(--accion-tx); outline-offset: 2px; }

  .ic { width: 1.05rem; height: 1.05rem; }

  /* El estado se declara UNA sola vez, en `aria-pressed` —que es además lo que
     anuncia el lector—, y el icono se elige mirándolo. Con una clase aparte
     habría dos fuentes de verdad para lo mismo y se desincronizan. */
  .mandos button[data-mando='giro'] .ic-girar { display: none; }
  .mandos button[data-mando='giro'][aria-pressed='true'] .ic-pausa { display: none; }
  .mandos button[data-mando='giro'][aria-pressed='true'] .ic-girar { display: block; }
  .mandos button[aria-pressed='true'] { color: var(--accion-tx); }

  /* En una pantalla táctil no hay cursor que acercar, así que no hay forma de
     descubrirlos: se quedan visibles del todo. */
  @media (hover: none) {
    .mandos { opacity: 0.75; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mandos { transition: none; }
  }

  .respaldo { position: relative; }
  .respaldo :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--borde);
  }
  .respaldo figcaption { margin-top: var(--e1); color: var(--tx4); }
</style>
