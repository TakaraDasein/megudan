---
import { Image } from 'astro:assets';
import portada from '../assets/texturas/acopio-culmos.jpg';
import productos from '../data/productos.json';
import { sitio } from '../data/sitio';
import ConmutadorRama from './ConmutadorRama.astro';

/**
 * Portada de la rama de compra.
 *
 * Antes esta página abría con «Tipos de corte», que es la lámina «Meso» del
 * manual: oficio de obra, no de despacho. Quien llega aquí viene a preguntar
 * qué piezas hay y si se las mandan, y el corte le contestaba otra cosa. El
 * corte se fue a la portada, debajo de la banda de verbos, que es donde ese
 * argumento sí trabaja.
 *
 * Aquí abre el acopio: culmos ya cortados y apilados, que es la fotografía del
 * material listo. Y en vez de un segundo dibujo, la columna de la derecha
 * enumera lo que se despacha, tomado de `productos.json` —la misma fuente que
 * el catálogo de más abajo, para que no haya dos listas que se desincronicen—.
 *
 * La mecánica es la de la portada de obra: `data-obertura` escalona los
 * `data-alza` en el orden en que están escritos, y el botón toma el vidrio del
 * conmutador para que las dos piezas se lean como una familia. Ver Hero.astro.
 */
const piezas = [...productos].sort((a, b) => a.orden - b.orden).map((p) => p.titulo);
---

<section class="hero">
  <div class="lienzo" transition:name="lienzo-portada">
    <Image
      src={portada}
      alt="Culmos de guadua cortados a la medida y apilados en el acopio, listos para despacho"
      widths={[900, 1600, 2200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      data-parallax="12"
    />
  </div>

  <div class="contenedor rejilla" data-obertura>
    <div class="cuerpo">
      <p class="lema" data-alza>{sitio.lema}</p>

      <h1>
        <span class="fijo" data-alza data-revelar-texto>Guadua seleccionada</span>
        <em data-alza>y despachada a tu obra.</em>
      </h1>

      <p class="bajada" data-alza>
        Cortamos, curamos e inmunizamos el material antes de cargarlo. Dinos la
        pieza, la cantidad y a dónde va: te pasamos precio y fecha de entrega.
      </p>

      <div class="ramas" data-alza><ConmutadorRama activa="comprar" /></div>
    </div>

    <!-- Segunda columna: qué se despacha, en la misma lista que el catálogo.
         Es lo primero que pregunta quien llega a esta rama, y responderlo
         arriba evita que tenga que bajar a averiguar si existe su pieza.

         La acción cierra la tarjeta en vez de ir bajo el titular: leída la
         lista, el botón es el renglón siguiente —«esto hay, pídelo»— y las dos
         piezas se leen como un solo bloque en lugar de repartir la conversión
         entre las dos columnas. -->
    <div class="piezas" data-alza>
      <p class="rotulo">Lo que despachamos</p>
      <ul>
        {piezas.map((p) => (
          <li><a href="#tipos">{p}</a></li>
        ))}
      </ul>
      <a class="camino principal boton-guadua" href="#calificador">
        Quiero comprar guadua
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    /* `svh` y no `vh` por lo mismo que la otra portada: con `100vh` el botón
       se va por debajo del pliegue en celular. */
    min-height: min(88svh, 780px);
    display: flex;
    align-items: center;
    padding-block: var(--e5);
    overflow: hidden;
  }

  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: var(--e5);
    align-items: center;
  }

  .lienzo { position: absolute; inset: 0; z-index: 0; border-radius: var(--borde); overflow: hidden; }
  .lienzo :global(img) {
    width: 100%;
    height: 118%; /* margen para que el parallax no descubra el borde */
    object-fit: cover;
    object-position: 50% 55%;
  }
  .lienzo::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to top,
        var(--bg) 2%,
        color-mix(in srgb, var(--bg) 86%, transparent) 38%,
        color-mix(in srgb, var(--bg) 45%, transparent) 78%,
        color-mix(in srgb, var(--bg) 25%, transparent) 100%
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--bg) 70%, transparent) 0%,
        transparent 62%
      );
  }

  .rejilla { position: relative; z-index: 1; }
  .cuerpo :where(p, h1) { text-shadow: 0 1px 10px rgb(0 0 0 / 0.55); }

  .lema {
    font-family: var(--disp);
    font-weight: 700;
    font-size: var(--t-xs);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accion-tx);
  }

  h1 {
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    margin-block: var(--e2) var(--e3);
    max-width: 17ch;
  }
  /* La máscara del revelado la lleva el span, no el h1: si el `hidden` se
     quedara arriba nadie lo levantaría y el titular entero desaparecería. */
  h1 .fijo { display: block; visibility: hidden; }
  h1 em {
    display: block;
    font-family: var(--acento-tipo);
    font-style: italic;
    font-weight: 400;
    font-optical-sizing: auto;
    letter-spacing: -0.015em;
  }

  .bajada { color: var(--tx2); font-size: var(--t-lg); max-width: 46ch; margin-bottom: var(--e4); }

  .ramas { margin-top: var(--e4); }
  /* Dentro de la tarjeta el botón ocupa el ancho: es el pie del bloque, no una
     pieza suelta al lado de la lista. */
  .camino {
    display: block;
    text-align: center;
    margin-top: var(--e4);
    font-family: var(--disp);
    font-weight: 600;
    font-size: var(--t-base);
    padding-block: 0.9rem;
    border-radius: var(--borde);
    text-decoration: none;
    border: 1px solid transparent;
    color: var(--tx);
  }
  /* El mismo vidrio del conmutador que tiene debajo: sobre fotografía un
     relleno naranja macizo se lee como una pieza pegada encima de la página.
     La acción la llevan el texto y el filo en `--accion-tx`. Ver Hero.astro. */
  .camino.principal {
    background: color-mix(in srgb, var(--s2) 72%, transparent);
    backdrop-filter: blur(10px);
    border-color: var(--accion-honda);
    color: var(--accion-tx);
    box-shadow: 0 6px 18px -10px rgb(0 0 0 / 0.8);
    transition: transform 0.25s cubic-bezier(0.3, 0.9, 0.4, 1), border-color 0.25s,
      box-shadow 0.25s;
  }
  .camino.principal:hover {
    transform: scale(1.03);
    border-color: var(--accion-tx);
    box-shadow: 0 12px 26px -12px rgb(0 0 0 / 0.9);
  }
  .camino.principal:active { transform: scale(0.99); }

  /* La lista va sobre el lado abierto del velo, así que se apoya en su propio
     vidrio para no perderse contra la fotografía. */
  .piezas {
    justify-self: end;
    width: 100%;
    max-width: 380px;
    padding: var(--e4);
    border: 1px solid var(--line);
    border-radius: var(--borde);
    background: color-mix(in srgb, var(--s2) 72%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.9);
  }
  .piezas .rotulo { color: var(--tx3); margin-bottom: var(--e2); }
  .piezas ul { list-style: none; margin: 0; padding: 0; }
  .piezas li + li { border-top: 1px solid var(--line); }
  /* Acotado a la lista: dentro de la tarjeta también vive el botón, y sin el
     `li` estos estilos le pisaban el relleno y el color. */
  .piezas li a {
    display: block;
    padding-block: 0.65rem;
    font-family: var(--disp);
    font-weight: 600;
    color: var(--tx);
    text-decoration: none;
  }
  .piezas li a:hover { color: var(--accion-tx); }

  @media (max-width: 900px) {
    .rejilla { grid-template-columns: minmax(0, 1fr); gap: var(--e4); }
    .piezas { justify-self: start; max-width: 460px; }
  }
  @media (prefers-reduced-motion: reduce) {
    h1 .fijo { visibility: visible; }
    .camino.principal:hover, .camino.principal:active { transform: none; }
  }
</style>
