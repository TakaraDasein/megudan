---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Tarjetas repartidas por la pared de un cilindro que gira sobre su eje.
 *
 * Va en el visor del calificador: la primera pregunta ramifica el embudo y
 * cada rama enseña aquí lo suyo —obra levantada o material despachado—. Un
 * mosaico plano decía lo mismo pero se leía como un catálogo; el cilindro
 * enseña las mismas piezas sin pedir que se recorran.
 *
 * **No es una isla.** Todo el movimiento es un `@keyframes` de `rotateY` sobre
 * un contenedor en `preserve-3d`: no hay estado, ni puntero, ni bucle. Meter
 * React aquí sería pagar hidratación por una animación que el navegador ya
 * sabe hacer solo.
 *
 * Cuatro decisiones que no son obvias:
 *
 * 1. **El radio se calcula aquí, no con `tan()` de CSS.** La fórmula es la
 *    misma —el apotema de un polígono regular de `n` lados—, pero resuelta en
 *    el servidor sale un número de píxeles fijo que entiende cualquier
 *    navegador, y `tan()` en CSS es reciente. Calculado aquí, además, se sabe
 *    cuánto amplía la perspectiva y se puede pedir la imagen a esa medida.
 * 2. **`backface-visibility: hidden`.** Sin esto se ven las tarjetas del fondo
 *    del cilindro, en espejo y al revés, cruzándose con las de delante.
 * 3. **La máscara lateral es lo que hace que sea un cilindro y no un carrusel.**
 *    Difuminando los bordes, las tarjetas no aparecen ni desaparecen de golpe
 *    en el filo de la caja: entran y salen de la vuelta.
 * 4. **El giro se para al pasar el cursor.** Es lo que vuelve mirable una
 *    pieza concreta; sin eso, señalar una y no poder detenerla molesta.
 * 5. **La proporción la fija el marco, no la imagen.** Un `aspect-ratio` en el
 *    `<img>` no sirve: Astro le escribe el atributo `height` con el alto real
 *    de la foto y ese gana, así que la tarjeta se estira a mil y pico píxeles
 *    y el `object-fit: cover` acaba enseñando un recorte irreconocible.
 * 6. **La resolución se pide por la altura del marco, no por su ancho.** El
 *    marco es vertical y casi toda la obra está fotografiada en apaisado: con
 *    `cover`, la foto se escala hasta cubrir el alto y le sobra ancho por los
 *    lados. Pidiéndola al ancho del marco llega a menos de la mitad de lo que
 *    hace falta y se ve blanda.
 * 7. **Con pocas piezas el anillo se completa repitiéndolas.** Cinco tarjetas
 *    hacen un cilindro tan estrecho que casi todas quedan de espaldas y solo
 *    se ven dos, con un vacío en medio. Dando la vuelta otra vez, la repetida
 *    sale en el lado opuesto y nunca se ve junto a su original.
 */
export interface Pieza {
  imagen: ImageMetadata;
  titulo: string;
  /** Segunda línea del rótulo: tipo de obra, presentación del material… */
  nota?: string;
}

interface Props {
  piezas: Pieza[];
  /** Ancho de tarjeta en px. El radio del cilindro sale de aquí y del número. */
  ancho?: number;
  /** Una vuelta completa, en segundos. */
  duracion?: number;
  /** Aire entre tarjeta y tarjeta, en px. */
  aire?: number;
  /** Tarjetas mínimas del anillo; con menos piezas, la lista se repite. */
  minimo?: number;
}
const { piezas, ancho = 150, duracion = 44, aire = 10, minimo = 9 } = Astro.props;

const vueltas = piezas.length ? Math.ceil(minimo / piezas.length) : 0;
const tarjetas = Array.from(
  { length: piezas.length * vueltas },
  (_, i) => piezas[i % piezas.length],
);

const n = tarjetas.length;
/* Apotema del polígono regular: a qué distancia del eje hay que empujar cada
   tarjeta para que las `n` caras se toquen sin solaparse. Con menos de tres
   piezas no hay cilindro que armar y el radio se queda en cero. */
const radio = n > 2 ? Math.round((ancho / 2 + aire) / Math.tan(Math.PI / n)) : 0;
const paso = 360 / n;

/* La perspectiva se ata al radio: fijarla en un valor absoluto deforma el
   cilindro en cuanto cambia el número de piezas. Seis radios es lo que hace
   que se lea como un cilindro sin caricaturizarlo; a la mitad, la tarjeta de
   delante se hincha hasta taparle el sitio a sus vecinas. */
const alto = Math.round((ancho * 10) / 7);
const perspectiva = radio * 6;

/* Cuánto agranda la perspectiva a la tarjeta que pasa por delante: está a un
   radio de la pared del fondo, así que crece en p / (p − r). De aquí sale
   tanto el alto de la caja —sin esto el overflow le corta la cabeza y los
   pies— como la resolución que hay que pedirle a la imagen: a 1.2× y en
   pantalla dpr 2, una foto servida al ancho nominal llega borrosa. */
const frente = radio ? perspectiva / (perspectiva - radio) : 1;
const anchoFrente = Math.ceil(ancho * frente);
const altoFrente = Math.ceil(alto * frente);

/** Ancho al que hay que servir una foto para que llene el marco con `cover`. */
const anchoUtil = (img: ImageMetadata) => {
  const relacion = img.width / img.height;
  const necesario = relacion > 7 / 10 ? altoFrente * relacion : anchoFrente;
  // Nunca por encima del original: pedirle a Astro más de lo que hay no
  // inventa detalle y sí emite una variante que pesa de más.
  return Math.min(Math.ceil(necesario), img.width);
};
---

{n > 0 && (
  <div
    class="cilindro"
    style={`--ancho: ${ancho}px; --alto: ${altoFrente}px; --duracion: ${duracion}s; --perspectiva: ${perspectiva}px;`}
  >
    <div class="anillo">
      {tarjetas.map((pieza, i) => (
        <figure
          class="tarjeta"
          style={`transform: rotateY(${(i * paso).toFixed(4)}deg) translateZ(${radio}px);`}
        >
          <div class="marco">
            <Image
              src={pieza.imagen}
              alt={pieza.titulo}
              widths={[anchoUtil(pieza.imagen), Math.min(anchoUtil(pieza.imagen) * 2, pieza.imagen.width)]}
              sizes={`${anchoUtil(pieza.imagen)}px`}
              loading="lazy"
            />
          </div>
          <figcaption>
            <span class="titulo">{pieza.titulo}</span>
            {pieza.nota && <span class="nota">{pieza.nota}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
)}

<style>
  .cilindro {
    display: grid;
    margin-block: var(--e3);
    place-items: center;
    width: 100%;
    /* `--alto` ya viene con la ampliación de la perspectiva aplicada; lo que
       se suma es el sitio del rótulo, que cuelga por debajo de la tarjeta. */
    height: calc(var(--alto) + var(--e5));
    perspective: var(--perspectiva);
    overflow: hidden;

    /* Lo que lo vuelve un cilindro: las tarjetas se van en vez de cortarse. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 14% 86%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 14% 86%, transparent);
  }

  .anillo {
    display: grid;
    place-items: center;
    transform-style: preserve-3d;
    animation: vuelta var(--duracion) linear infinite;
  }
  .cilindro:hover .anillo,
  .cilindro:focus-within .anillo { animation-play-state: paused; }

  @keyframes vuelta {
    to { transform: rotateY(1turn); }
  }

  .tarjeta {
    grid-area: 1 / 1;
    width: var(--ancho);
    backface-visibility: hidden;
    /* La transición es del realce, no del sitio: el `transform` lo escribe el
       elemento y animarlo pelearía con la vuelta. */
    transition: filter 0.3s ease;
  }
  .marco {
    aspect-ratio: 7 / 10;
    overflow: hidden;
    border-radius: var(--borde);
    /* Las fotos son de obra, con cielos y fondos claros; sobre la sección
       oscura del calificador un borde tenue las asienta. */
    border: 1px solid var(--line);
    background: var(--s2);
  }
  .marco :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cilindro:hover .tarjeta { filter: brightness(0.6) saturate(0.7); }
  .cilindro .tarjeta:hover { filter: none; }

  figcaption {
    display: grid;
    gap: 2px;
    padding-top: var(--e1);
    text-align: center;
  }
  .titulo {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--tx2);
  }
  .nota {
    font-size: var(--t-xs);
    line-height: 1.3;
    color: var(--tx4);
  }

  /* Con el movimiento apagado el cilindro se queda quieto de frente. Sigue
     siendo legible: la tarjeta central se lee entera y las de al lado dan a
     entender que hay más. */
  @media (prefers-reduced-motion: reduce) {
    .anillo { animation: none; }
  }
</style>
