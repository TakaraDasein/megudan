---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Capa de textura fotográfica.
 *
 * Sobre fondo oscuro una foto a baja opacidad se ve sucia, no texturada. Por
 * eso la capa va con `mix-blend-mode` y con una máscara que la desvanece hacia
 * los bordes: la textura se insinúa donde no hay texto y desaparece donde sí.
 */
interface Props {
  src: ImageMetadata;
  alt?: string;
  opacidad?: number;
  /** `soft-light` conserva el fondo; `overlay` marca más el material. */
  mezcla?: 'soft-light' | 'overlay' | 'luminosity' | 'normal';
  /** Desvanece la capa hacia dónde, para dejar respirar el texto. */
  desvanecer?: 'bordes' | 'centro' | 'derecha' | 'abajo' | 'ninguno';
  class?: string;
}
const {
  src,
  opacidad = 0.3,
  mezcla = 'soft-light',
  desvanecer = 'bordes',
  class: clase,
} = Astro.props;

const mascaras = {
  bordes:
    'radial-gradient(ellipse 90% 80% at 50% 50%, #000 30%, transparent 100%)',
  /* La inversa de `bordes`: el material vive a los costados y el centro queda
     limpio. Es lo que hace falta cuando el texto va centrado y grande. */
  centro:
    'radial-gradient(ellipse 58% 150% at 50% 50%, transparent 25%, #000 88%)',
  derecha: 'linear-gradient(to right, transparent 0%, #000 55%)',
  abajo: 'linear-gradient(to bottom, #000 40%, transparent 100%)',
  ninguno: 'none',
};
const mascara = mascaras[desvanecer];
---

<div
  class:list={['textura', clase]}
  aria-hidden="true"
  style={`--op:${opacidad}; --mezcla:${mezcla}; --mascara:${mascara}`}
>
  <Image src={src} alt="" widths={[600, 1100, 1600]} sizes="100vw" loading="lazy" decoding="async" />
</div>

<style>
  .textura {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--op);
    mix-blend-mode: var(--mezcla);
    -webkit-mask-image: var(--mascara);
    mask-image: var(--mascara);
  }
  .textura :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
