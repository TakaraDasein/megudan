---
import { Image } from 'astro:assets';
import verde from '../../assets/texturas/guadua-verde.jpg';

/**
 * Fondo fotográfico de guadual.
 *
 * Sustituye a un dibujo de líneas que resultaba esquemático. Detrás de un
 * formulario, una fotografía desenfocada lee como profundidad de campo —igual
 * que en una foto de producto bien hecha— mientras que un trazo vectorial lee
 * como plantilla.
 *
 * Tres tratamientos la vuelven fondo y no imagen:
 *   · desenfoque, para que ningún detalle compita con el texto;
 *   · oscurecido fuerte, porque el contenido va encima;
 *   · máscara diagonal, que la concentra abajo a la izquierda y la retira de
 *     donde vive la tarjeta.
 */
interface Props {
  opacidad?: number;
  /** Radio de desenfoque en px. */
  desenfoque?: number;
}
const { opacidad = 0.55, desenfoque = 3 } = Astro.props;
---

<div
  class="guadual-fondo"
  aria-hidden="true"
  style={`--op:${opacidad}; --blur:${desenfoque}px`}
>
  <div class="deriva" data-deriva>
    <Image
      src={verde}
      alt=""
      widths={[900, 1500]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>

<style>
  .guadual-fondo {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--op);
    /* Se concentra abajo a la izquierda y se retira de la tarjeta. */
    -webkit-mask-image:
      linear-gradient(to top right, #000 0%, transparent 66%),
      linear-gradient(to top, #000 0%, #000 46%, transparent 88%);
    mask-image:
      linear-gradient(to top right, #000 0%, transparent 66%),
      linear-gradient(to top, #000 0%, #000 46%, transparent 88%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  /* Sobredimensionada para que la deriva nunca descubra un borde. */
  .deriva {
    position: absolute;
    inset: -6%;
    width: 112%;
    height: 112%;
  }

  .guadual-fondo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Desenfoque + oscurecido: pasa de fotografía a fondo. */
    filter: blur(var(--blur)) brightness(0.58) saturate(0.95) contrast(1.12);
  }
</style>
