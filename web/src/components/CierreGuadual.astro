---
import Pie from './Pie.astro';
import Dosel from './ilustraciones/cierre/dosel.svg';
import Culmo from './ilustraciones/cierre/culmo.svg';
import Rizoma from './ilustraciones/cierre/rizoma.svg';

/**
 * El cierre de la portada.
 *
 * La página termina en el pie. Quien siga bajando lo abre: el pie se retira y
 * el guadual desciende del dosel hasta el brote, en sentido inverso al video
 * original. Es el movimiento contrario al del resto del sitio —que va de la
 * materia a la obra— y devuelve al visitante al punto de partida.
 *
 * Todo el tramo es reversible: al subir, el guadual se recoge y el pie vuelve.
 *
 * TRES MENSAJES SOBRE LA SECUENCIA, uno por plano.
 *
 * El descenso ya contaba una historia —del dosel al brote— pero la contaba sin
 * palabras, y quien no sepa de guadua ve un bosque bonito. Cada mensaje entra
 * cuando la cámara llega a su plano: la copa arriba, el culmo a media altura y
 * el rizoma cuando la secuencia toca el suelo. El dibujo que lo acompaña es ese
 * mismo plano tallado, no un icono: la bóveda, la caña con su cota de corte, y
 * lo que no se ve desde ninguna cámara —el rizoma con sus yemas—.
 *
 * NINGUNA CIFRA ES NUEVA: las tres salen del manifiesto de la sección de
 * servicios, palabra por palabra. Y el tercero dice `rizoma` y no `semilla`
 * a propósito: la guadua florece de forma gregaria cada varias décadas y en la
 * práctica no se propaga por semilla sino por rizoma. Escribir «la semilla»
 * aquí sería poner en la web un dato que el primer vivero desmentiría.
 */
const TOTAL = 72;
const ultimo = '/secuencia/guadual-071.webp';

/**
 * Los tres momentos, en el orden en que la cámara baja.
 *
 * Cuándo entra cada uno lo reparte motion.ts sobre el tramo fijado; aquí solo
 * se declara el orden, que es el del descenso. Ver `cierreGuadual`.
 */
const momentos = [
  {
    dibujo: Dosel,
    titulo: 'Seis meses hasta esta altura',
    apoyo: 'Un guadual alcanza su altura en una sola temporada. Ninguna madera de obra crece así.',
  },
  {
    dibujo: Culmo,
    titulo: 'Se corta a los cuatro o seis años',
    apoyo: 'Por encima del nudo, y solo las cañas hechas. La mata se queda en pie.',
  },
  {
    dibujo: Rizoma,
    titulo: 'Y vuelve a salir del mismo rizoma',
    apoyo: 'Bajo tierra el guadual es una sola planta. Cortar una caña no lo termina: lo renueva.',
  },
];
---

<div class="cierre" data-cierre data-total={TOTAL}>
  <div class="escena">
    <!-- El guadual, oculto detrás del pie hasta que se activa. -->
    <div class="guadual" data-guadual aria-hidden="true">
      <img src={ultimo} width="1280" height="720" alt="" data-poster />
      <canvas data-lienzo></canvas>

      <!-- EL VIRADO. Dos capas de color puestas a mezclar con la imagen, no
           un velo encima: el origen es un vídeo de 720p con un verde de cámara
           —amarillento y algo lavado— que llegaba al pie sin parecerse a
           ningún otro verde del sitio.

           `color` toma el TONO del Verde Oscuro del manual y respeta la
           luminancia de la fotografía, así que el guadual conserva su relieve
           y su profundidad; un velo con opacidad, en cambio, aplana. Encima,
           una pizca de oliva en `soft-light` devuelve el brillo que el virado
           se lleva, y es el mismo oliva de la numeración: el pie cierra con
           los colores con los que la página abre. -->
      <div class="tinte" aria-hidden="true"></div>

      <!-- Sin textura fotográfica encima: una imagen con estructura propia
           sobre el video deja vetas fantasma. El cuerpo se lo dan el filtro
           del propio lienzo y el viñeteado. -->
      <div class="vineta"></div>

      <p class="leyenda rotulo" data-leyenda>
        De la copa al brote
      </p>
    </div>

    <!-- LOS MENSAJES VAN FUERA DEL `[data-guadual]`, que es `aria-hidden`.
         Dentro habrían quedado escondidos del árbol de accesibilidad junto con
         la fotografía, y esto no es decorado: es el único sitio del sitio donde
         se explica de dónde sale el material. Apilados en la misma celda de la
         rejilla —como las vistas del calificador— para que ninguno mueva a los
         otros al entrar. -->
    <ol class="momentos" data-momentos aria-label="La vida del guadual, del dosel al rizoma">
      {momentos.map((m, i) => {
        const Dibujo = m.dibujo;
        return (
          <li class="momento" data-momento={i}>
            <div class="dibujo" aria-hidden="true"><Dibujo /></div>
            <h3>{m.titulo}</h3>
            <p>{m.apoyo}</p>
          </li>
        );
      })}
    </ol>

    <div class="pie-envoltura" data-pie-envoltura>
      <Pie />
    </div>
  </div>
</div>

<style>
  /* La altura extra es el recorrido de scroll que abre el cierre.
     Se anula en celular y con movimiento reducido. */
  .cierre { position: relative; }

  /* El pie se ancla al fondo de una pantalla completa: ese es el espacio que
     el guadual va a ocupar al abrirse. */
  .escena {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .guadual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    /* El virado se mezcla con la fotografía y CON NADA MÁS. Sin aislar, un
       `mix-blend-mode` busca su fondo subiendo hasta el primer contexto de
       apilamiento, y aquí el de arriba es la página entera: el pie que hay
       debajo se teñía con ella. */
    isolation: isolate;
    border-radius: var(--borde);
    pointer-events: none;
    background: var(--bg);
    /* Recortado a cero por arriba: al abrirse crece hacia abajo, en el sentido
       contrario al que sube la caña en el resto del sitio. */
    clip-path: inset(0 0 100% 0);
  }
  .guadual img,
  .guadual canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El origen es un vídeo de 720p algo plano: se le sube cuerpo y se le
       enfría un punto para que empate con el verde de la paleta. La saturación
       baja de 1,2 a 1,05 desde que hay virado: sumadas, el verde se iba a
       fosforescente y el pie dejaba de leerse como fotografía. */
    filter: contrast(1.16) saturate(1.05) brightness(0.84) hue-rotate(-4deg);
  }
  .guadual canvas { opacity: 0; }
  .guadual canvas.activo { opacity: 1; }

  .tinte {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* La capa del tono. Al 52 % la fotografía sigue siendo fotografía; por
     encima del 70 % pasa a ser un duotono y el guadual deja de leerse como un
     sitio real, que es lo único que el pie tiene que decir. */
  .tinte::before,
  .tinte::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tinte::before {
    background: var(--s2);
    mix-blend-mode: color;
    opacity: 0.52;
  }
  /* Y el punto de luz. `soft-light` aclara donde ya hay luz y no toca las
     sombras, así que el claro entre las cañas se abre y el suelo se queda
     donde estaba. */
  .tinte::after {
    background: var(--estructura);
    mix-blend-mode: soft-light;
    opacity: 0.22;
  }

  /* Viñeteado: oscurece los bordes y disimula el bloque de compresión. */
  .vineta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 78% 72% at 50% 45%, transparent 40%, color-mix(in srgb, var(--bg) 92%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 80%, transparent) 0%, transparent 22%);
  }

  .leyenda {
    position: absolute;
    left: 50%;
    bottom: var(--e5);
    transform: translateX(-50%);
    color: var(--tx2);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.7);
    opacity: 0;
    white-space: nowrap;
  }

  /* --- LOS TRES MOMENTOS ------------------------------------------------ */

  /* Apilados en una celda, a media altura de la escena y sin interceptar el
     puntero: por debajo sigue habiendo página, y el cierre no es una parada
     con la que se interactúe.

     ALTERNADOS A LOS LADOS, no centrados. Los tres entran en la misma celda,
     así que centrados caían exactamente en el mismo sitio y el cambio de
     momento se leía como un parpadeo del mismo bloque. Puestos a izquierda,
     derecha e izquierda, el relevo se ve: el descenso avanza en zigzag y el
     centro de la fotografía —la caña que la cámara sigue— queda despejado. */
  .momentos {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    align-items: center;
    justify-items: center;
    list-style: none;
    margin: 0;
    padding: 0 clamp(var(--e5), 7vw, var(--e6));
    pointer-events: none;
  }
  .momento {
    position: relative;
    grid-area: 1 / 1;
    max-width: 34ch;
    padding: var(--e4) var(--e4) var(--e5);
    text-align: center;
  }

  /* El lado por posición, no por contenido: primero y tercero a la izquierda,
     el del culmo a la derecha. Solo por encima del ancho donde caben las 34ch
     a un lado sin comerse la mitad de la escena; por debajo siguen centrados,
     que es lo que ya hacían. */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    .momento:nth-child(odd) { justify-self: start; text-align: left; }
    .momento:nth-child(even) { justify-self: end; text-align: right; }
    .momento:nth-child(odd) .dibujo { margin-left: 0; margin-right: auto; }
    .momento:nth-child(even) .dibujo { margin-left: auto; margin-right: 0; }
  }

  .momento {
    /* Quietos hasta que la secuencia llega a su plano. Los mueve motion.ts;
       aquí solo se declara el reposo. Sin JavaScript nadie los encendería, así
       que el apagado cuelga de la marca del `<head>`, como el resto. */
    opacity: 0;
  }
  :global(html:not([data-js])) .momento { opacity: 1; }

  /* UN VELO DETRÁS DEL BLOQUE, no una caja. La viñeta de la escena oscurece
     los bordes, pero el centro —que es justo donde va el texto— es la parte
     clara de la fotografía: medido sobre el fotograma del dosel, el renglón de
     apoyo se perdía contra el cielo entre las cañas. Un rectángulo con fondo
     lo resolvería y convertiría el cierre en una diapositiva; un óvalo
     difuminado apaga lo justo y no tiene borde que se vea.

     Va como pseudoelemento del propio bloque para que se apague CON él: la
     opacidad que anima GSAP es la del `<li>`, y el velo la hereda. */
  .momento::before {
    content: '';
    position: absolute;
    inset: -12% -18%;
    z-index: -1;
    background: radial-gradient(
      ellipse 62% 58% at 50% 50%,
      color-mix(in srgb, var(--bg) 78%, transparent) 0%,
      color-mix(in srgb, var(--bg) 52%, transparent) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* El dibujo manda en el bloque: es el plano del que habla la frase. 150 px
     es lo que aguanta sobre fotografía en movimiento sin que el trazo se
     confunda con una caña del fondo. */
  .momento .dibujo {
    width: 170px;
    height: 170px;
    margin: 0 auto var(--e2);
    color: var(--tx);
    filter: drop-shadow(0 2px 14px rgb(0 0 0 / 0.75));
  }
  .momento .dibujo :global(svg) { display: block; width: 100%; height: 100%; }

  .momento h3 {
    font-family: var(--disp);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--tx);
    text-shadow: 0 1px 12px rgb(0 0 0 / 0.8);
  }
  /* El apoyo va a cuerpo de texto y no de rótulo: es una frase que se lee, y
     sobre fotografía en movimiento `--t-sm` en `--tx2` no se sostenía. */
  .momento p {
    margin-top: var(--e2);
    font-size: var(--t-base);
    line-height: 1.45;
    color: var(--tx);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.85);
  }

  /* EL TALLADO, POR VARIABLE Y NO POR KEYFRAMES.

     En el resto del sitio el vaciado es una animación CSS que arranca al
     entrar el bloque en pantalla, y ahí sirve porque ocurre una vez. Aquí no:
     el tramo va con `scrub`, así que el visitante lo recorre hacia delante y
     hacia atrás con la rueda, y una animación CSS no sabe de eso. Atada a una
     clase, el resultado medido era un dibujo a medio tallar —doce trazos en
     `scaleX(0)` y uno entero— según dónde parase la rueda.

     Con `--gu-t` manda la línea de tiempo: es el avance del filo, de 0 a 1, y
     lo escribe GSAP trazo a trazo. Al subir se recoge, como se recoge todo lo
     demás del cierre. La misma solución que las juntas de sección, que animan
     `--nudo-regla` porque quien dibuja es un pseudoelemento.

     El valor por defecto es 1: sin JavaScript el dibujo está tallado entero,
     que es como tiene que verse cuando no hay quien lo talle. */
  .momento .dibujo :global(.gu) {
    transform-box: view-box;
    transform-origin: var(--x, 50%) var(--y, 50%);
    transform: rotate(var(--a)) scaleX(var(--gu-t, 1)) rotate(calc(-1 * var(--a)));
  }
  /* Una masa no se abre con el filo, se entinta: no escala, aparece. */
  .momento .dibujo :global(.gu.masa) {
    transform: none;
    opacity: var(--gu-t, 1);
  }

  .pie-envoltura { position: relative; }

  @media (max-width: 780px), (prefers-reduced-motion: reduce) {
    /* Sin cierre: el pie se comporta como un pie normal. */
    .guadual { display: none; }

    /* PERO LOS MENSAJES SE QUEDAN. Son contenido, no una capa de la animación:
       si desaparecieran con ella, la única explicación de dónde sale el
       material existiría solo para quien tenga puntero y no haya pedido menos
       movimiento. Aquí bajan al flujo, en fila y encima del pie, y se ven los
       tres a la vez —que es lo que el tramo fijado enseña de uno en uno—. */
    .escena { min-height: 0; }
    .momentos {
      position: static;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: var(--e4);
      padding: var(--e6) var(--e4);
      border-bottom: 1px solid var(--line);
    }
    /* Y SE DESAPILAN. El `grid-area: 1 / 1` de arriba los mete a los tres en
       la misma celda, que es lo que hace falta sobre la fotografía —entran de
       uno en uno y ninguno mueve a los otros—. Aquí no hay fotografía ni
       entradas: en flujo, apilados, los tres títulos se dibujan uno encima de
       otro. Cambiar las columnas del contenedor no lo deshace; hay que
       devolverle la celda a cada hijo. */
    .momento { grid-area: auto; opacity: 1; max-width: none; padding: 0; }
    /* Sin fotografía debajo no hay nada que apagar. */
    .momento::before { display: none; }
    .momento .dibujo { width: 110px; height: 110px; color: var(--cruda); filter: none; }
    .momento h3, .momento p { text-shadow: none; }
    .momento .dibujo :global(.gu) { transform: none; opacity: 1; }
  }
</style>
