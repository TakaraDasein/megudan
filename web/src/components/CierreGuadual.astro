---
import Pie from './Pie.astro';

/**
 * El cierre de la portada.
 *
 * La página termina en el pie. Quien siga bajando lo abre: el pie se retira y
 * el guadual desciende del dosel hasta el brote, en sentido inverso al video
 * original. Es el movimiento contrario al del resto del sitio —que va de la
 * materia a la obra— y devuelve al visitante al punto de partida.
 *
 * Todo el tramo es reversible: al subir, el guadual se recoge y el pie vuelve.
 */
const TOTAL = 72;
const ultimo = '/secuencia/guadual-071.webp';
---

<div class="cierre" data-cierre data-total={TOTAL}>
  <div class="escena">
    <!-- El guadual, oculto detrás del pie hasta que se activa. -->
    <div class="guadual" data-guadual aria-hidden="true">
      <img src={ultimo} width="1280" height="720" alt="" data-poster />
      <canvas data-lienzo></canvas>

      <!-- Sin textura fotográfica encima: una imagen con estructura propia
           sobre el video deja vetas fantasma. El cuerpo se lo dan el filtro
           del propio lienzo y el viñeteado. -->
      <div class="vineta"></div>

      <p class="leyenda rotulo" data-leyenda>
        De la copa al brote · seis meses de crecimiento
      </p>
    </div>

    <div class="pie-envoltura" data-pie-envoltura>
      <Pie />
    </div>
  </div>
</div>

<style>
  /* La altura extra es el recorrido de scroll que abre el cierre.
     Se anula en celular y con movimiento reducido. */
  .cierre { position: relative; }

  /* El pie se ancla al fondo de una pantalla completa: ese es el espacio que
     el guadual va a ocupar al abrirse. */
  .escena {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }

  .guadual {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: var(--borde);
    pointer-events: none;
    background: var(--bg);
    /* Recortado a cero por arriba: al abrirse crece hacia abajo, en el sentido
       contrario al que sube la caña en el resto del sitio. */
    clip-path: inset(0 0 100% 0);
  }
  .guadual img,
  .guadual canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* El origen es un vídeo de 720p algo plano: se le sube cuerpo y se le
       enfría un punto para que empate con el verde de la paleta. */
    filter: contrast(1.14) saturate(1.2) brightness(0.86) hue-rotate(-4deg);
  }
  .guadual canvas { opacity: 0; }
  .guadual canvas.activo { opacity: 1; }

  /* Viñeteado: oscurece los bordes y disimula el bloque de compresión. */
  .vineta {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse 78% 72% at 50% 45%, transparent 40%, color-mix(in srgb, var(--bg) 92%, transparent) 100%),
      linear-gradient(to bottom, color-mix(in srgb, var(--bg) 80%, transparent) 0%, transparent 22%);
  }

  .leyenda {
    position: absolute;
    left: 50%;
    bottom: var(--e5);
    transform: translateX(-50%);
    color: var(--tx2);
    text-shadow: 0 1px 10px rgb(0 0 0 / 0.7);
    opacity: 0;
    white-space: nowrap;
  }

  .pie-envoltura { position: relative; }

  @media (max-width: 780px), (prefers-reduced-motion: reduce) {
    /* Sin cierre: el pie se comporta como un pie normal. */
    .guadual { display: none; }
  }
</style>
