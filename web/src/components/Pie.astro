---
import { sitio, enlaceWhatsApp } from '../data/sitio';
const wa = enlaceWhatsApp('Hola Megudan, quiero más información.');
const anio = new Date().getFullYear();
---

<footer class="nudo">
  <div class="contenedor rejilla">
    <div>
      <p class="rotulo">Contacto</p>
      <a class="tel" href={wa} target="_blank" rel="noopener">{sitio.telefonoVisible}</a>
      <p class="nota">WhatsApp — respondemos el mismo día</p>
    </div>

    <div>
      <p class="rotulo">Cobertura</p>
      <!-- Los mismos municipios que ofrecen los dos calificadores —ver
           `data/calificadores.ts`—. Si la cobertura cambia, cambian los tres
           sitios a la vez: esta nota, las dos listas de opciones y el mapa de
           `herramientas/mapa-despacho.py`. -->
      <p class="nota">Pitalito, Bruselas, San Agustín e Isnos, sin recargo de desplazamiento.</p>
      <p class="nota">Resto del país, suministro de material por transportadora.</p>
    </div>

    <div>
      <p class="rotulo">Qué hacemos</p>
      <p class="nota">Diseño y construcción en guadua, asesoría e inmunizado.</p>
      <p class="nota"><a href="/#comprar">Comprar guadua →</a></p>
    </div>
  </div>

  <!-- LA FIRMA CIERRA LA PÁGINA. El lockup a tamaño de firma y no de rótulo:
       es lo último que queda en pantalla y aquí no compite con nada, así que
       puede leerse entero. -->
  <div class="contenedor cierre">
    <a class="firma" href="/" aria-label={sitio.nombreLargo}>
      <img src="/marca/logo.svg" alt="" width="752" height="287" />
    </a>
    <span class="rotulo">{sitio.nombreLargo} · {anio}</span>
  </div>
</footer>

<style>
  footer { padding-top: var(--e5); }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--e4);
    padding-bottom: var(--e5);
  }
  .tel {
    display: block;
    font-family: var(--disp);
    font-size: var(--t-xl);
    font-weight: 600;
    color: var(--accion-tx);
    text-decoration: none;
    margin-block: var(--e1);
  }
  .nota { font-size: var(--t-sm); color: var(--tx3); }
  /* El relleno es el objetivo de pulsación, y va en la regla base y no solo en
     la consulta de móvil: el renglón mide 17 px y la norma pide 24 (WCAG
     2.5.8) en cualquier pantalla, no solo con el dedo. El margen negativo
     devuelve el hueco para que no se separen los renglones del pie. */
  .nota a {
    display: inline-block;
    padding-block: 0.4rem;
    margin-block: -0.4rem;
    color: var(--accion-tx);
    text-decoration: none;
  }
  .nota a:hover { text-decoration: underline; }
  .cierre {
    border-top: 1px solid var(--line);
    padding-block: var(--e3) var(--e5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--e2);
  }
  /* EL TAMAÑO. Crece con la ventana pero con tope: pasado cierto punto el
     lockup deja de ser firma y se convierte en un cartel. */
  .firma {
    display: block;
    line-height: 0;
    border-radius: var(--borde);
    /* El origen es el borde IZQUIERDO: al crecer desde el centro, el lockup
       se metía bajo el margen de la caja por la izquierda. Anclado al canto,
       crece solo hacia dentro de la página. */
    transform-origin: left center;
    transform: scale(var(--z, 1));
    transition: transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }
  .firma img { display: block; height: clamp(56px, 7.5vw, 96px); width: auto; }

  /* BAJO EL CURSOR CRECE. Escalar el enlace y no cambiar la altura del `<img>`
     es lo que mantiene el pie quieto: una transformada no rehace el flujo, así
     que el renglón de al lado no se mueve ni salta el alto del pie.

     `:focus-visible` con el mismo trato, para que quien navega con teclado vea
     la misma respuesta que quien apunta con el ratón. */
  .firma:hover,
  .firma:focus-visible { --z: 1.12; }

  /* Solo donde hay cursor de verdad. En táctil el `:hover` se queda pegado
     después de tocar y la firma se quedaría grande sin motivo. */
  @media (hover: none) {
    .firma:hover { --z: 1; }
  }

  @media (max-width: 780px) {
    /* La franja del botón flotante YA está reservada, y una sola vez: es el
       `padding-bottom` que Nav.astro le pone al `body` para toda la página.
       Repetirla aquí la sumaba dos veces y dejaba un vano de casi diez rem
       de fondo vacío después de la firma. */

    /* Con el dedo, un enlace es la altura de su caja y no la de sus letras: a
       17 px de alto se falla el toque. Se estiran a 44 sin tocar la
       composición, que es lo mínimo con lo que se acierta sin apuntar. */
    .nota a, .cierre .rotulo { display: inline-block; padding-block: 0.75rem; }
    .tel { padding-block: 0.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .firma { transition: none; }
  }
</style>
