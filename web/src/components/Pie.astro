---
import { sitio, enlaceWhatsApp } from '../data/sitio';
const wa = enlaceWhatsApp('Hola Megudan, quiero más información.');
const anio = new Date().getFullYear();
---

<footer class="nudo">
  <div class="contenedor rejilla">
    <div>
      <p class="rotulo">Contacto</p>
      <a class="tel" href={wa} target="_blank" rel="noopener">{sitio.telefonoVisible}</a>
      <p class="nota">WhatsApp — respondemos el mismo día</p>
    </div>

    <div>
      <p class="rotulo">Cobertura</p>
      <!-- Los mismos municipios que ofrecen los dos calificadores —ver
           `data/calificadores.ts`—. Si la cobertura cambia, cambian los tres
           sitios a la vez: esta nota, las dos listas de opciones y el mapa de
           `herramientas/mapa-despacho.py`. -->
      <p class="nota">Pitalito, Bruselas, San Agustín e Isnos, sin recargo de desplazamiento.</p>
      <p class="nota">Resto del país, suministro de material por transportadora.</p>
    </div>

    <div>
      <p class="rotulo">Qué hacemos</p>
      <p class="nota">Diseño y construcción en guadua, asesoría e inmunizado.</p>
      <p class="nota"><a href="/#comprar">Comprar guadua →</a></p>
    </div>
  </div>

  <div class="contenedor cierre">
    <img class="firma" src="/marca/logo.svg" alt={sitio.nombreLargo} width="752" height="287" />
    <span class="rotulo">{sitio.nombreLargo} · {anio}</span>
  </div>
</footer>

<style>
  footer { padding-top: var(--e5); }
  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--e4);
    padding-bottom: var(--e5);
  }
  .tel {
    display: block;
    font-family: var(--disp);
    font-size: var(--t-xl);
    font-weight: 600;
    color: var(--accion-tx);
    text-decoration: none;
    margin-block: var(--e1);
  }
  .nota { font-size: var(--t-sm); color: var(--tx3); }
  /* El relleno es el objetivo de pulsación, y va en la regla base y no solo en
     la consulta de móvil: el renglón mide 17 px y la norma pide 24 (WCAG
     2.5.8) en cualquier pantalla, no solo con el dedo. El margen negativo
     devuelve el hueco para que no se separen los renglones del pie. */
  .nota a {
    display: inline-block;
    padding-block: 0.4rem;
    margin-block: -0.4rem;
    color: var(--accion-tx);
    text-decoration: none;
  }
  .nota a:hover { text-decoration: underline; }
  .cierre {
    border-top: 1px solid var(--line);
    padding-block: var(--e3) var(--e5);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--e2);
  }
  /* La firma cierra la página: aquí el lockup respira y sí se lee completo. */
  .firma { display: block; height: 44px; width: auto; }

  @media (max-width: 780px) {
    .cierre { padding-bottom: 5.5rem; } /* deja aire para el botón flotante */

    /* Con el dedo, un enlace es la altura de su caja y no la de sus letras: a
       17 px de alto se falla el toque. Se estiran a 44 sin tocar la
       composición, que es lo mínimo con lo que se acierta sin apuntar. */
    .nota a, .cierre .rotulo { display: inline-block; padding-block: 0.75rem; }
    .tel { padding-block: 0.4rem; }
  }
</style>
