---
/**
 * Muro de obra: una vista rápida de todo el trabajo antes de las bandas.
 *
 * El muro va de frente y completo: `fit` reparte el ancho del contenedor entre
 * las cinco columnas, así que ninguna se sale ni se corta, y sin cabeceo ni
 * giro la retícula queda a plomo. La perspectiva solo se usa al entrar: el clic
 * atraviesa el muro hacia la obra.
 *
 * TRES COLUMNAS, Y LAS OBRAS VAN MEZCLADAS. Antes eran cinco y cada columna era
 * un proyecto: los ítems se reparten con `i % columns`, y con la ronda de ida y
 * vuelta que se arma abajo, cinco columnas dejaban cada obra en la suya. Eso
 * permitía rotular las columnas por fuera, y esa fila de nombres ya no existe
 * —con tres columnas y cinco obras no hay biyección posible, y un rótulo fijo
 * sobre una columna que mezcla tres obras es sencillamente falso—.
 *
 * Lo que se gana: a cinco columnas la ficha se quedaba en unos 260 px de ancho
 * y una casa entera a ese tamaño es una mancha. A tres, la fotografía tiene
 * sitio. Y quien quiera saber cuáles son las obras tiene ahora la vista de
 * cuadrícula al lado, que es donde se mudó ese trabajo (`VistaObra.astro`).
 *
 * Aquí el nombre sigue apareciendo donde siempre tuvo sentido: sobre la ficha
 * que se apunta (cambio 2 del componente). Pasar el cursor detiene esa columna
 * y descubre el rótulo; el clic entra a la ficha de obra. Es la segunda isla React del sitio, y existe porque el efecto
 * es de puntero y de rAF: en HTML estático no se puede.
 *
 * Las fotos pasan por `getImage()` en compilación, no por URLs crudas: así
 * Astro las deduplica y las emite en WebP al tamaño de la ficha, igual que
 * haría `<Image>`.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Muro from './islands/MuroProyectos';
import { fotosParaMuro } from '../lib/obra';

/** Fotos por proyecto que entran al muro. Cinco proyectos × cinco = 25 fichas. */
const POR_PROYECTO = 5;

/**
 * Columnas del muro. Ya NO es `proyectos.length`: cuántas obras hay y cuántas
 * columnas caben con holgura son dos preguntas distintas, y atarlas hacía que
 * añadir una sexta obra estrechase el muro entero sin que nadie lo pidiera.
 */
const COLUMNAS = 3;

const proyectos = (await getCollection('proyectos')).sort(
  (a, b) => a.data.orden - b.data.orden,
);

// Ronda: p1, p2, p3, p4, p5, p1, p2… — el reparto por columnas del componente
// convierte esta ronda en una columna por proyecto.
const ronda = Array.from({ length: POR_PROYECTO }, (_, vuelta) =>
  proyectos.map((p) => {
    const fotos = fotosParaMuro(p, POR_PROYECTO);
    return { p, foto: fotos[vuelta % fotos.length] };
  }),
).flat();

const fichas = await Promise.all(
  ronda.map(async ({ p, foto }) => {
    const opt = await getImage({
      src: foto,
      widths: [340, 680],
      sizes: '340px',
      format: 'webp',
    });
    return {
      image: opt.src,
      srcset: opt.srcSet.attribute,
      title: p.data.titulo,
      alt: `${p.data.titulo} — obra en guadua`,
      href: `/obra/${p.id}`,
    };
  }),
);
---

<div class="muro">
  <Muro
    client:visible
    items={fichas}
    columns={COLUMNAS}
    fit
    tileWidth={340}
    tileHeight={226}
    gap={18}
    radius={10}
    scale={1}
    tilt={0}
    turn={0}
    perspective={1400}
    depth={0}
    speed={34}
    variance={0.4}
    parallax={0.22}
    lift={70}
    fade={0.62}
    dim={0.5}
    overlayColor="#1D2316"
  />

  <p class="pista rotulo">Pasa el cursor y entra a la obra</p>
</div>

<style>
  /* El tinte de obra, compuesto con la cadena que ya trae la ficha.
     `filter` no se acumula entre reglas: la última declaración gana entera, así
     que aquí se repite el reposo del muro —`grayscale(var(--dw-gray))
     saturate(0.92)`, MuroProyectos.css— y su estado activo, con el tinte
     encadenado detrás. Si cambia allí, cambia aquí.

     Va con `:global` porque las clases son del componente React vendorizado, y
     vive en este envoltorio y no en MuroProyectos.css para no meter mano de
     Megudan en el cuerpo de upstream. */
  .muro :global(.drift-wall__tile img) {
    filter: grayscale(var(--dw-gray)) saturate(0.92) var(--tinte-obra);
  }

  .muro :global(.drift-wall__tile.is-active img),
  .muro :global(.drift-wall__tile:focus-visible img) {
    filter: grayscale(0) saturate(1.05) var(--tinte-obra);
  }

  .muro {
    position: relative;
    /* Más alto que la primera versión: el muro es una ventana a un plano que
       sigue derivando por detrás, y cuanto más alta la ventana, más columnas
       en movimiento caben a la vez y más se lee como cantidad de obra. El tope
       de 900 px es lo que cabe en un portátil de 1080 sin empujar la banda
       fuera de la pantalla —por encima de eso la sección deja de verse entera
       y el muro pasa de ser una vista a ser una parada—. */
    height: clamp(560px, 86vh, 900px);
    /* Sin aire por debajo: el muro muere contra el filete de la banda que
       sigue. Con los 4 rem que había, las fichas se desvanecían a media altura
       y quedaba una franja de fondo vacío antes de la línea; la columna parecía
       cortada y no continuada. Pegado, el desvanecido del componente y el filete
       caen en el mismo sitio y las fichas desaparecen justo en el borde, que es
       donde tiene que acabar una ventana. */
    margin-bottom: 0;
    /* El muro se apoya en el fondo del sitio: la máscara del componente
       desvanece los bordes contra este mismo color. */
    background: var(--bg);
  }

  .pista {
    position: absolute;
    inset-inline: 0;
    /* Levantada del borde: pegada al filete de la banda se leía como rótulo de
       la banda y no como indicación del muro. */
    bottom: var(--e3);
    text-align: center;
    color: var(--tx3);
    pointer-events: none;
  }

  /* Sin puntero el muro no se puede recorrer y las 25 fichas son peso muerto:
     en celular manda la lista de bandas, que ya está debajo. */
  @media (max-width: 780px) {
    .muro { display: none; }
  }
</style>
