---
import { Image } from 'astro:assets';
import productos from '../data/productos.json';
import Portico from './ilustraciones/portico.svg';
import Atado from './ilustraciones/atado.svg';
import Union from './ilustraciones/union.svg';
import SurHuila from './ilustraciones/sur-huila.svg';
import Pocas from './ilustraciones/pocas.svg';
import Media from './ilustraciones/media.svg';
import Muchas from './ilustraciones/muchas.svg';
import Calculo from './ilustraciones/calculo.svg';
import AreaChica from './ilustraciones/area-chica.svg';
import AreaMedia from './ilustraciones/area-media.svg';
import AreaGrande from './ilustraciones/area-grande.svg';
import Anclaje from './ilustraciones/anclaje.svg';
import Inmunizado from './ilustraciones/inmunizado.svg';
import Reemplazo from './ilustraciones/reemplazo.svg';

/**
 * Panel izquierdo del calificador.
 *
 * En reposo muestra el titular. Al enfocar una opción de la primera pregunta
 * lo reemplaza por lo que esa opción significa: la obra que se levanta, el
 * material que se despacha, o lo que se revisa en una asesoría.
 *
 * Las respuestas van dibujadas, no fotografiadas. Antes eran carruseles de
 * obra y de producto, y una foto concreta invita a compararse con ella: quien
 * ve la Casa Anolaima decide si su caso se parece a esa casa. El dibujo dice
 * qué se hace sin decir cuál, que es lo que hace falta *antes* de contestar.
 *
 * Están tallados con la gubia del isotipo —ver herramientas/gubia.py—, así que
 * se leen como marca y no como iconos comprados. Y el pórtico y el atado no se
 * distinguen por su tema sino por lo que traen: el atado lleva cota y el
 * pórtico no. Ahí está la diferencia entre comprar y construir.
 *
 * Es una respuesta a una intención, no un adorno: quien duda entre construir y
 * comprar ve de inmediato en qué se está metiendo cada camino.
 *
 * Solo se emiten las vistas que el calificador de esta página puede activar.
 * No es solo peso: las vistas se apilan en la misma celda de la rejilla y una
 * oculta sigue ocupando alto, así que emitir las tres en /comprar-guadua —donde
 * ninguna se activa nunca— dejaba un hueco largo debajo del titular.
 */
interface Props {
  /** Antetítulo sobre el titular. Se omite cuando el titular ya lo dice todo. */
  rotulo?: string;
  titulo: string;
  /** Opcional: el panel de compra ya no la lleva. Ver HeroCompra. */
  bajada?: string;
  /** Vistas que puede pedir el calificador; el resto ni se imprime. */
  vistas?: string[];
  /**
   * `h1` cuando este panel ES la portada del modo, `h2` cuando es una sección
   * más de la página. No es cosmético: en el modo comprar el calificador subió
   * al hero y el titular de marca desapareció con él, así que si este siguiera
   * siendo `h2` ese modo se quedaría sin ningún `h1` —sin nombre para los
   * buscadores ni ancla para quien navega por encabezados—.
   */
  titular?: boolean;
}
const { rotulo, titulo, bajada, vistas = [], titular = false } = Astro.props;
const muestra = (v: string) => vistas.includes(v);

/**
 * Los recortes de catálogo, para las vistas `pieza:<slug>`.
 *
 * Estas no son como las otras tres: no reemplazan el titular, se abren debajo
 * de él. Un material no responde a «en qué me estoy metiendo» —eso ya lo
 * contestó el conmutador de rama— sino a «cuál de las cinco es la mía», y esa
 * se contesta viendo la pieza. Por eso aquí sí va fotografía y no gubia.
 *
 * Mismo glob y mismo motivo que en TiposDeGuadua: webp con alfa, y Astro emite
 * el original de todo lo que se importa en `eager`.
 */
const recortes = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/productos/**/*.{jpg,webp}',
  { eager: true },
);
const foto = (rutas: string[]) => {
  for (const r of rutas) {
    const hit = recortes[`../assets/${r}`];
    if (hit) return hit.default;
  }
  return null;
};

/**
 * El mapa de despacho, para las vistas `zona:<municipio>`.
 *
 * Vive en la misma celda que los recortes y por el mismo motivo: es la
 * respuesta a lo que el visitante está apuntando, no una sección aparte. Los
 * dos nunca coinciden —son pasos distintos del embudo—, así que comparten
 * altura y el panel no cambia de tamaño en todo el recorrido.
 *
 * Sale de `herramientas/mapa-despacho.py` con límites municipales reales
 * (geoBoundaries / DANE). No hay librería de mapas: a esta escala, con cinco
 * puntos que no hacen zoom ni se arrastran, un SVG tallado al compilar dice lo
 * mismo sin JavaScript, sin red y sin traerse la paleta de OpenStreetMap a un
 * panel donde todo lo demás está dibujado a mano.
 */
const mapa = vistas.some((v) => v.startsWith('zona:'));

const piezas = vistas
  .filter((v) => v.startsWith('pieza:'))
  .map((v) => productos.find((p) => p.slug === v.slice('pieza:'.length)))
  .filter((p): p is (typeof productos)[number] => Boolean(p))
  .map((p) => ({ slug: p.slug, img: foto(p.imagenes) }))
  .filter((p) => p.img);

/** El apunte cuenta las presentaciones que hay, no las que había cuando se escribió. */
const cuantas =
  ['Una', 'Dos', 'Tres', 'Cuatro', 'Cinco', 'Seis'][productos.length - 1] ??
  String(productos.length);
---

<div class="visor" data-visor>
  <!-- Reposo -->
  <div class="vista activa" data-vista="reposo">
    <div class="texto">
      {rotulo && <p class="rotulo">{rotulo}</p>}
      {/* Dos ramas con etiqueta literal y no una variable `<Titulo>`: Astro
          acota los estilos añadiendo un atributo a cada elemento que ve escrito,
          y una etiqueta dinámica la trata como componente y se queda sin él —el
          titular perdería su estilo entero—. */}
      {titular
        ? <h1 data-revelar-texto set:html={titulo} />
        : <h2 data-revelar-texto set:html={titulo} />}
      {bajada && <p class="bajada">{bajada}</p>}
    </div>

    <!-- EN LA MISMA CELDA QUE EL TEXTO, no debajo: mientras el cursor está
         sobre una opción, la pieza —o el mapa— OCUPA EL SITIO DEL TITULAR y el
         titular se apaga.

         Apilados, el panel no tiene que reservar alto para las dos cosas a la
         vez: la imagen dispone de la columna entera y el titular no queda
         empujado contra el techo. Debajo, cada uno se quedaba con la mitad y
         ninguno de los dos respiraba.

         Van sin pie: el botón que el visitante está señalando ya dice el
         nombre, y la medida se pregunta dos pasos más adelante. Repetirlas aquí
         era leer en voz alta lo que la mano ya está tocando. -->
    {(piezas.length > 0 || mapa) && (
      <div class="escena" aria-hidden="true">
        {piezas.length > 0 && (
          <div class="piezas" data-piezas>
            {piezas.map((p) => (
              <figure class="pieza" data-pieza={p.slug}>
                <Image src={p.img!} alt="" widths={[380, 760]} sizes="380px" loading="lazy" />
              </figure>
            ))}
          </div>
        )}

        {/* El mapa se enciende entero al llegar al paso del despacho y por
            dentro señala un municipio. Ese doble estado es `.activa` en el
            envoltorio y `data-zona` en él mismo. */}
        {mapa && <div class="mapa" data-mapa><SurHuila /></div>}
      </div>
    )}
  </div>

  <!-- Comprar guadua -->
  {muestra('suministro') && (
  <div class="vista" data-vista="suministro" aria-hidden="true">
    <p class="rotulo">Lo que despachamos</p>
    <div class="dibujo"><Atado /></div>
    <p class="apunte">{cuantas} presentaciones de la misma caña, cada una para un trabajo distinto.</p>
  </div>
  )}

  <!-- Diseño y construcción -->
  {muestra('construccion') && (
  <div class="vista" data-vista="construccion" aria-hidden="true">
    <p class="rotulo">Lo que levantamos</p>
    {/* Dibujo y no fotografía: la pregunta se contesta antes de decidir, y una
        obra concreta invita a compararse con ella en vez de a reconocerse. El
        pórtico dice qué se levanta sin decir cuál. Va tallado con la gubia del
        isotipo —crema sobre el fondo, ancho variable, puntas afiladas— para
        que se lea como marca y no como icono comprado. */}
    <div class="dibujo"><Portico /></div>
    <p class="apunte">Del pedestal a la cubierta, todo en guadua curada.</p>
  </div>
  )}

  <!-- Revisión — tres detalles, no una escala.

       Los apuntes dicen qué se mira en cada uno, que es lo que el rótulo del
       botón no alcanza a decir: «uniones y anclajes» nombra el sitio, no la
       pregunta que se le hace. -->
  {muestra('anclaje') && (
  <div class="vista" data-vista="anclaje" aria-hidden="true">
    <div class="dibujo"><Anclaje /></div>
    <p class="apunte">El único punto donde la guadua toca algo que no es guadua: si la platina abraza y si el perno apoya contra el entrenudo relleno.</p>
  </div>
  )}

  {muestra('inmunizado') && (
  <div class="vista" data-vista="inmunizado" aria-hidden="true">
    <div class="dibujo"><Inmunizado /></div>
    <p class="apunte">Un culmo tratado y uno sin tratar se ven igual. Lo que se revisa es si pasó por el tanque.</p>
  </div>
  )}

  {muestra('reemplazo') && (
  <div class="vista" data-vista="reemplazo" aria-hidden="true">
    <div class="dibujo"><Reemplazo /></div>
    <p class="apunte">Una pieza sale y entra otra sin tocar la estructura. Eso no se puede con una viga vaciada.</p>
  </div>
  )}

  <!-- Tamaño — la misma planta con más vanos.

       Los apuntes cuentan apoyos y crujías, no repiten los metros: el botón
       que el visitante está señalando ya trae el rango escrito, y decirlo otra
       vez aquí sería leerle en voz alta lo que tiene bajo la mano. -->
  {muestra('area-chica') && (
  <div class="vista" data-vista="area-chica" aria-hidden="true">
    <div class="dibujo"><AreaChica /></div>
    <p class="apunte">Un vano cubierto de esquina a esquina, sin apoyos intermedios.</p>
  </div>
  )}

  {muestra('area-media') && (
  <div class="vista" data-vista="area-media" aria-hidden="true">
    <div class="dibujo"><AreaMedia /></div>
    <p class="apunte">Aparece la crujía intermedia: el techo ya no cruza de fachada a fachada.</p>
  </div>
  )}

  {muestra('area-grande') && (
  <div class="vista" data-vista="area-grande" aria-hidden="true">
    <div class="dibujo"><AreaGrande /></div>
    <p class="apunte">La planta deja de ser un rectángulo y empieza a tener alas.</p>
  </div>
  )}

  <!-- Cantidad — las tres primeras son el mismo montón creciendo.

       Estas van con `apunte` y sin `rotulo`: el antetítulo de las otras tres
       vistas contesta «qué es esto» —lo que levantamos, lo que despachamos—, y
       aquí eso ya lo contestó el paso anterior. Lo que falta es la unidad de
       medida del montón que se está viendo, y esa va debajo. -->
  {muestra('pocas') && (
  <div class="vista" data-vista="pocas" aria-hidden="true">
    <div class="dibujo"><Pocas /></div>
    <p class="apunte">Culmos sueltos, sin atar. Se despachan contados.</p>
  </div>
  )}

  {muestra('media') && (
  <div class="vista" data-vista="media" aria-hidden="true">
    <div class="dibujo"><Media /></div>
    <p class="apunte">Ya es atado: se cincha y se carga entero.</p>
  </div>
  )}

  {muestra('muchas') && (
  <div class="vista" data-vista="muchas" aria-hidden="true">
    <div class="dibujo"><Muchas /></div>
    <p class="apunte">Volumen de estiba. Aquí el flete se cotiza por viaje.</p>
  </div>
  )}

  {muestra('calculo') && (
  <div class="vista" data-vista="calculo" aria-hidden="true">
    <div class="dibujo"><Calculo /></div>
    <p class="apunte">Con las medidas de lo que vas a cubrir sacamos el conteo.</p>
  </div>
  )}

  <!-- Asesoría -->
  {muestra('asesoria') && (
  <div class="vista" data-vista="asesoria" aria-hidden="true">
    <p class="rotulo">Lo que revisamos</p>
    {/* Único de los tres con llamadas: «asesoría» no se contesta con una obra
        ni con un material, sino con un detalle. Las letras del dibujo y las de
        la lista son las mismas y en el mismo orden — si dejaran de coincidir,
        las letras pasarían a ser decoración. */}
    <div class="dibujo"><Union /></div>
    <ol class="lista-asesoria">
      <li><b>Si la boca de pescado asienta</b> o si la pieza trabaja al aire.</li>
      <li><b>Contra qué apoya el perno</b>: el entrenudo relleno o la pared sola.</li>
      <li><b>Si el entrenudo tiene mortero</b> o quedó hueco al montarlo.</li>
    </ol>
  </div>
  )}
</div>

<style>
  /* Las vistas se apilan: la altura la fija la más alta y nada salta al
     cambiar.

     `height: 100%` para que el panel pueda entregarle la altura de su fila y
     la escena reparta lo que sobre —ver `.escena`—. Donde el panel no tiene
     altura propia (el modo construir) esto se resuelve como `auto` y no hace
     nada. */
  .visor { position: relative; display: grid; height: 100%; min-height: 0; }
  .vista {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .vista.activa { opacity: 1; pointer-events: auto; visibility: visible; }
  /* El reposo apila texto y escena en UNA celda, como las vistas se apilan
     entre sí. Es lo que permite que la imagen releve al titular en vez de
     sumarse debajo de él. */
  .vista[data-vista='reposo'] { position: relative; display: grid; grid-template-rows: 1fr; min-height: 0; }
  .texto {
    grid-area: 1 / 1;
    align-self: start;
    transition: opacity 0.28s ease;
  }
  /* El titular se retira mientras hay algo señalado. No se oculta con
     `visibility` ni se saca del flujo: sigue ocupando su celda —de la que la
     escena también dispone— así que nada se recoloca al encenderse ni al
     apagarse. */
  .visor:has(.pieza.activa) .texto,
  .visor:has(.mapa.activa) .texto { opacity: 0; }

  /* `h1` y `h2` comparten estilo: cuál de los dos se emite lo decide `titular`
     —ver la nota de la propiedad—, y el nivel es información para el navegador,
     no un tamaño distinto en pantalla. */
  h1, h2 { font-size: var(--t-2xl); margin-block: var(--e2) var(--e3); visibility: hidden; }
  h1 :global(em), h2 :global(em) {
    font-family: var(--acento-tipo);
    font-style: italic;
    font-weight: 400;
    color: var(--cruda);
  }

  /* La numeración va en verde oliva porque es índice —estructura—, no acción.
     `list-style` con `lower-alpha` y no letras escritas a mano: si mañana entra
     un cuarto renglón, la lista y el dibujo se desincronizan a la vista y eso
     es justo lo que hay que notar. */
  .lista-asesoria {
    display: grid;
    gap: var(--e2);
    margin-top: var(--e3);
    max-width: 38ch;
    list-style: lower-alpha;
    padding-left: var(--e3);
  }
  .lista-asesoria li {
    padding-left: var(--e1);
    color: var(--tx3);
    font-size: var(--t-sm);
  }
  .lista-asesoria li::marker {
    font-family: var(--mono);
    color: var(--estructura);
  }
  .lista-asesoria b { color: var(--tx2); font-weight: 600; }

  /* El dibujo hereda el color del texto: es un vaciado de la misma plancha,
     no una imagen con su propia paleta. Al 82% se asienta detrás del titular
     en vez de competir con el formulario. */
  .dibujo { margin-top: var(--e3); color: var(--tx); opacity: 0.82; }
  .dibujo :global(svg) { display: block; width: 100%; max-width: 420px; height: auto; }

  /* --- El tallado ---------------------------------------------------- *
   *
   * Cada gubia se escala en su propia dirección desde el punto donde entra
   * el filo: el trazo *avanza* por la plancha en vez de aparecer. Eso es lo
   * que separa esto de un fundido —y es el motivo de que el generador emita
   * `--x`, `--y` y `--a` por trazo en vez de un path suelto.
   *
   * Arranca cuando la vista se vuelve `.activa`, no al entrar en pantalla:
   * la respuesta se talla cada vez que el visitante pasa por la opción, que
   * es cuando la pregunta está viva. Volver a poner la animación en un
   * elemento que ya la corrió exige que el navegador la reinicie, y lo hace
   * porque la clase entra y sale con el foco.
   *
   * Solo `transform`: nada aquí toca layout.
   */
  .vista.activa .dibujo :global(.gu) {
    transform-box: view-box;
    transform-origin: var(--x, 50%) var(--y, 50%);
    animation: tallar 0.34s cubic-bezier(0.3, 0.9, 0.4, 1) backwards;
    /* 22 ms por trazo: con ~40 gubias el dibujo se cierra en menos de un
       segundo, que es lo que dura la mirada antes de volver al formulario. */
    animation-delay: calc(var(--i) * 22ms);
  }
  /* Una masa no se abre con el filo: se entinta de golpe. */
  .vista.activa .dibujo :global(.gu.masa) { animation-name: entintar; }

  @keyframes tallar {
    from { transform: rotate(var(--a)) scaleX(0) rotate(calc(-1 * var(--a))); }
    to   { transform: rotate(var(--a)) scaleX(1) rotate(calc(-1 * var(--a))); }
  }
  @keyframes entintar {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Las cinco piezas comparten celda; el alto lo fija la más alta y ninguna
     empuja el texto al entrar. */
  /* La celda donde el panel contesta: los recortes de catálogo en el paso de
     la pieza y el mapa en el de despacho, apilados y nunca a la vez. El alto
     lo fija la escena y no su contenido —alto fijo, no mínimo—: con
     `min-height` lo primero que entra estira la celda y empuja media página
     hacia abajo justo cuando el visitante está apuntando a un botón. */
  /* LA ESCENA OCUPA LA CELDA ENTERA, la misma que el texto.
     Sin alto propio y sin tope: lo que mide es lo que mida el panel, que ya
     viene ajustado a su fila. Antes reservaba una banda fija debajo del texto
     y había que repartir el alto entre los dos; ahora se turnan.

     `min-height: 0` y `overflow: hidden` para que el contenido no imponga su
     alto intrínseco hacia arriba: el tamaño mínimo automático de un ítem de
     rejilla es el de su contenido, y sin esto una foto de 300 px volvería a
     estirar la fila —y con ella el panel, la portada y el conmutador—. */
  /* FUERA DEL FLUJO, no solo apilada. `grid-area` la ponía en la misma celda
     que el texto, pero seguía contando para medir la fila: una pista `1fr` en
     dimensionado intrínseco toma el MAX-CONTENT de sus ítems, y el max-content
     de una foto es su alto natural —545 px la rolliza—, que ni `min-height: 0`
     ni `overflow: hidden` recortan. El panel crecía a 545, la portada de compra
     se estiraba 119 px por debajo de la de obra y el conmutador se descolgaba.

     En absoluto no mide nada y ocupa todo: el panel lo dimensiona el titular
     —y la fila, el formulario— y la escena se queda con ese rectángulo, sea
     cual sea. */
  .escena {
    position: absolute;
    inset: 0;
    display: grid;
    overflow: hidden;
  }
  .piezas { grid-area: 1 / 1; display: grid; height: 100%; min-height: 0; }
  /* Recortes y mapa comparten celda Y encuadre: los dos centrados en el alto
     y arrimados al margen izquierdo. Estaban en ejes distintos —la foto
     apoyada abajo, el mapa centrado— y al pasar del paso de la pieza al del
     despacho el contenido daba un salto vertical que se leía como un
     desajuste, no como un cambio de contenido. */
  .pieza {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    align-self: center;
    justify-self: start;
  }
  .pieza.activa { opacity: 1; visibility: visible; }
  .pieza :global(img) {
    display: block;
    width: auto;
    max-width: min(380px, 100%);
    /* El recorte se acomoda al alto de la celda: la esterilla es apaisada y la
       rolliza vertical, y las dos tienen que caber sin cambiarlo. Al alto de
       la celda, no a un número: la escena ya no mide siempre lo mismo. */
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }

  /* --- EL MAPA DE DESPACHO ---------------------------------------------
   *
   * Geografía real —límites del DANE vía geoBoundaries, ver
   * `herramientas/mapa-despacho.py`— dibujada con la línea del sitio. Los
   * municipios vecinos van de marco: sin ellos las cuatro zonas flotan y no se
   * lee que son un bloque contiguo.
   *
   * El mapa entero aparece al apuntar cualquier opción del paso; cuál se
   * enciende lo dice `data-zona` en el mismo elemento. Dos estados separados a
   * propósito: el municipio cambia mucho más seguido que el mapa, y así ese
   * cambio no vuelve a montar nada.
   */
  .mapa {
    grid-area: 1 / 1;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    /* Ocupa la celda entera —la misma de la que dispone el titular— en vez de
       arrimarse a una esquina con un ancho tope. */
    align-self: stretch;
    justify-self: stretch;
  }
  .mapa.activa { opacity: 1; visibility: visible; }
  /* Al 100% en los dos ejes y que encaje solo: un SVG con `viewBox` y el
     `preserveAspectRatio` de serie se ajusta dentro de su caja sin deformarse,
     así que el mapa siempre sale tan grande como el panel permita —y sigue
     entero— sin tener que fijar aquí ningún número. */
  .mapa :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Reposo del mapa: es un dato, no una acción. Todo en café guadua, y la
     diferencia entre «zona que atendemos» y «vecino que solo enmarca» está en
     el relleno, no en el color. */
  .mapa :global(.mun) {
    fill: none;
    stroke: var(--cruda);
    stroke-width: 0.8;
    opacity: 0.35;
    transition: fill 0.25s ease, opacity 0.25s ease;
  }
  .mapa :global(.zona) { fill: var(--cruda); fill-opacity: 0.12; opacity: 0.6; }

  .mapa :global(.punto) { transition: opacity 0.25s ease; opacity: 0.45; }
  .mapa :global(.pin) { fill: var(--cruda); }
  .mapa :global(.halo) { fill: none; transition: fill 0.25s ease; }
  /* Los nombres empiezan apagados y los enciende el estado, uno a la vez.
     Con los cuatro puestos el mapa es una lista de municipios que ya está
     ahí al lado en botones, y encima San Agustín e Isnos quedan tan juntos
     que sus rótulos se pisan. */
  .mapa :global(.punto text) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    fill: var(--tx3);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  /* EL MUNICIPIO SEÑALADO. Naranja porque es la respuesta a lo que el cursor
     está pidiendo —acción—, mientras el resto del mapa sigue siendo dato en
     café guadua. Y el resto no solo se queda quieto: se retira al 16 %, que es
     lo que convierte «uno más encendido» en «uno, y los demás de fondo».

     Cuál está encendido lo marca `motion.ts` con la clase `.activa`, no una
     lista de municipios escrita aquí: así el día que entre un quinto pueblo no
     hay que acordarse de este archivo. «Otro municipio» enciende el mapa sin
     encender nada dentro —no hay punto que señalar— y el efecto es el correcto
     por sí solo: la zona entera se retira, que es justo lo que significa. */
  .mapa[data-zona] :global(.mun:not(.activa)) { opacity: 0.16; }
  .mapa :global(.mun.activa) {
    opacity: 1;
    fill: var(--accion);
    fill-opacity: 0.16;
    stroke: var(--accion-tx);
    stroke-width: 1.3;
  }

  .mapa[data-zona] :global(.punto:not(.activa)) { opacity: 0.22; }
  .mapa :global(.punto.activa) { opacity: 1; }
  .mapa :global(.punto.activa .pin) { fill: var(--accion-tx); }
  /* El halo solo existe encendido: es el pulso del punto que contesta. */
  .mapa :global(.punto.activa .halo) {
    fill: var(--accion);
    fill-opacity: 0.22;
  }
  .mapa :global(.punto.activa text) { opacity: 1; fill: var(--tx); }

  /* --- PANEL DE COMPRA: EL TITULAR SOLO --------------------------------
   *
   * Donde hay recortes de catálogo —solo el modo comprar— el reposo es un
   * titular grande y nada más: ni antetítulo ni bajada. El formulario está al
   * lado contándose solo, con su enunciado y su contador de pasos, así que el
   * párrafo repetía en prosa lo que la tarjeta ya enseña y le disputaba la
   * mirada al titular.
   *
   * La condición es `:has([data-piezas])` y no una propiedad nueva: la galería
   * de recortes solo existe si el calificador declara vistas `pieza:`, así que
   * el panel de obra —que no las tiene— conserva su cuerpo de letra de siempre
   * sin que haya que acordarse de pasarle nada.
   */
  .visor:has([data-piezas]) h1,
  .visor:has([data-piezas]) h2 {
    /* Por encima de `--t-3xl`: desde que la imagen releva al titular en vez de
       colocarse debajo, el titular tiene la columna entera para él y puede
       pesar lo que pesa el formulario de al lado. */
    font-size: clamp(2.6rem, 4.6vw, 4.2rem);
  }

  .apunte { font-size: var(--t-sm); color: var(--tx3); margin-top: var(--e2); max-width: 40ch; }

  /* EN CELULAR EL VISOR SE QUEDA EN SU TEXTO.
     Dos razones, y la segunda es la que decide:

     1. Apiladas en una columna, el dibujo y la pieza —300 px de alto fijo—
        metían unos 450 px entre la bajada y el formulario. Al pulsar
        «Hablemos» el visitante aterrizaba en el titular con la primera
        pregunta por debajo del pliegue, y encima tapada por el botón
        flotante. El embudo entero empezaba con un desplazamiento a ciegas.

     2. El visor responde a `mouseenter` y a `focus` sobre las opciones: es una
        respuesta a lo que el visitante *apunta* antes de decidir. Con el dedo
        no hay apuntar —se toca y ya está—, y al tocar el paso avanza y el
        visor vuelve a reposo. En táctil nunca llega a cambiar de vista: ocupa
        media pantalla para enseñar siempre lo mismo.

     El titular sí se queda: es el que dice qué se cotiza. */
  @media (max-width: 780px) {
    .dibujo, .escena, .apunte { display: none; }
  }

  /* VENTANA BAJA, la misma condición que los dos heros. El panel de compra es
     la pieza alta de su portada y aquí están sus dos costuras: un titular de
     tres renglones y el mínimo de la escena. Sin apretarlas, a 1280×700 el
     panel pedía 530 px para una fila de 469 y la portada de compra crecía por
     debajo de la de obra —y las dos tienen que ocupar la misma caja, que es lo
     que sostiene el cruce entre modos—. */
  @media (min-width: 901px) and (max-height: 940px) {
    .visor:has([data-piezas]) h1,
    .visor:has([data-piezas]) h2 { font-size: clamp(1.9rem, 3.1vw, 2.6rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* LOS DOS, no solo el `h2`. `revelarTexto` es quien quita el
       `visibility: hidden` que trae el titular de serie, y con movimiento
       reducido no corre: el panel de compra, que emite `h1` porque es la
       portada de su modo, se quedaba con el titular invisible para siempre.
       Justo para quien pidió menos movimiento. */
    h1, h2 { visibility: visible; }
    /* El dibujo entero, ya tallado, desde el primer fotograma. */
    .vista .dibujo :global(.gu) { animation: none; }
  }
