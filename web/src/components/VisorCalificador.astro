---
import { Image } from 'astro:assets';
import productos from '../data/productos.json';
import Portico from './ilustraciones/portico.svg';
import Atado from './ilustraciones/atado.svg';
import Union from './ilustraciones/union.svg';
import SurHuila from './ilustraciones/sur-huila.svg';
import Pocas from './ilustraciones/pocas.svg';
import Media from './ilustraciones/media.svg';
import Muchas from './ilustraciones/muchas.svg';
import Calculo from './ilustraciones/calculo.svg';
import AreaChica from './ilustraciones/area-chica.svg';
import AreaMedia from './ilustraciones/area-media.svg';
import AreaGrande from './ilustraciones/area-grande.svg';
import Anclaje from './ilustraciones/anclaje.svg';
import Inmunizado from './ilustraciones/inmunizado.svg';
import Reemplazo from './ilustraciones/reemplazo.svg';
import Guadual from './ilustraciones/panel/guadual.svg';

/**
 * Panel izquierdo del calificador.
 *
 * En reposo muestra el titular. Al enfocar una opción de la primera pregunta
 * lo reemplaza por lo que esa opción significa: la obra que se levanta, el
 * material que se despacha, o lo que se revisa en una asesoría.
 *
 * Las respuestas van dibujadas, no fotografiadas. Antes eran carruseles de
 * obra y de producto, y una foto concreta invita a compararse con ella: quien
 * ve la Casa Anolaima decide si su caso se parece a esa casa. El dibujo dice
 * qué se hace sin decir cuál, que es lo que hace falta *antes* de contestar.
 *
 * Están tallados con la gubia del isotipo —ver herramientas/gubia.py—, así que
 * se leen como marca y no como iconos comprados. Y el pórtico y el atado no se
 * distinguen por su tema sino por lo que traen: el atado lleva cota y el
 * pórtico no. Ahí está la diferencia entre comprar y construir.
 *
 * Es una respuesta a una intención, no un adorno: quien duda entre construir y
 * comprar ve de inmediato en qué se está metiendo cada camino.
 *
 * Solo se emiten las vistas que el calificador de esta página puede activar.
 * No es solo peso: las vistas se apilan en la misma celda de la rejilla y una
 * oculta sigue ocupando alto, así que emitir las tres en /comprar-guadua —donde
 * ninguna se activa nunca— dejaba un hueco largo debajo del titular.
 */
interface Props {
  /** Antetítulo sobre el titular. Se omite cuando el titular ya lo dice todo. */
  rotulo?: string;
  titulo: string;
  /** Opcional: el panel de compra ya no la lleva. Ver HeroCompra. */
  /** Vistas que puede pedir el calificador; el resto ni se imprime. */
  vistas?: string[];
  /**
   * `h1` cuando este panel ES la portada del modo, `h2` cuando es una sección
   * más de la página. No es cosmético: en el modo comprar el calificador subió
   * al hero y el titular de marca desapareció con él, así que si este siguiera
   * siendo `h2` ese modo se quedaría sin ningún `h1` —sin nombre para los
   * buscadores ni ancla para quien navega por encabezados—.
   */
  titular?: boolean;
}
const { rotulo, titulo, vistas = [], titular = false } = Astro.props;
const muestra = (v: string) => vistas.includes(v);

/**
 * Los recortes de catálogo, para las vistas `pieza:<slug>`.
 *
 * Estas no son como las otras tres: no reemplazan el titular, se abren debajo
 * de él. Un material no responde a «en qué me estoy metiendo» —eso ya lo
 * contestó el conmutador de rama— sino a «cuál de las cinco es la mía», y esa
 * se contesta viendo la pieza. Por eso aquí sí va fotografía y no gubia.
 *
 * Mismo glob y mismo motivo que en TiposDeGuadua: webp con alfa, y Astro emite
 * el original de todo lo que se importa en `eager`.
 */
const recortes = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/productos/**/*.{jpg,webp}',
  { eager: true },
);
const foto = (rutas: string[]) => {
  for (const r of rutas) {
    const hit = recortes[`../assets/${r}`];
    if (hit) return hit.default;
  }
  return null;
};

/**
 * El mapa de despacho, para las vistas `zona:<municipio>`.
 *
 * Vive en la misma celda que los recortes y por el mismo motivo: es la
 * respuesta a lo que el visitante está apuntando, no una sección aparte. Los
 * dos nunca coinciden —son pasos distintos del embudo—, así que comparten
 * altura y el panel no cambia de tamaño en todo el recorrido.
 *
 * Sale de `herramientas/mapa-despacho.py` con límites municipales reales
 * (geoBoundaries / DANE). No hay librería de mapas: a esta escala, con cinco
 * puntos que no hacen zoom ni se arrastran, un SVG tallado al compilar dice lo
 * mismo sin JavaScript, sin red y sin traerse la paleta de OpenStreetMap a un
 * panel donde todo lo demás está dibujado a mano.
 */
const mapa = vistas.some((v) => v.startsWith('zona:'));

/**
 * El calendario de las vistas `fecha:<tramo>`.
 *
 * Doce semanas en columnas de cinco días, agrupadas de cuatro en cuatro: el
 * horizonte que cubren las dos preguntas de tiempo del sitio. Al señalar una
 * opción se encienden sus semanas y el resto se retira, igual que el mapa
 * enciende un municipio.
 *
 * SE DIBUJA AQUÍ Y NO EN UNA HERRAMIENTA. Los dibujos de gubia salen de
 * `herramientas/gubia.py` porque son talla a mano, y el mapa de
 * `herramientas/mapa-despacho.py` porque necesita límites municipales reales.
 * Un calendario no es ninguna de las dos cosas: es una rejilla, doce por
 * cinco, y un bucle de tres líneas la escribe mejor que un archivo generado
 * que habría que regenerar para mover una celda.
 *
 * Los tramos van en un atributo y no en el CSS ni en el JS: quien cambie las
 * opciones de una pregunta cambia el rango aquí al lado, no en tres archivos.
 * Un tramo vacío —«estoy cotizando», «estoy explorando»— enciende el
 * calendario sin marcar nada, que es exactamente lo que significa.
 */
const SEMANAS = 12;
const TRAMOS: Record<string, [number, number] | []> = {
  'esta-semana': [1, 1],
  'dos-a-cuatro': [2, 4],
  pronto: [1, 2],
  'uno-a-tres-meses': [4, 12],
  abierto: [],
};
const calendario = vistas.some((v) => v.startsWith('fecha:'));

const piezas = vistas
  .filter((v) => v.startsWith('pieza:'))
  .map((v) => productos.find((p) => p.slug === v.slice('pieza:'.length)))
  .filter((p): p is (typeof productos)[number] => Boolean(p))
  .map((p) => ({ slug: p.slug, img: foto(p.imagenes) }))
  .filter((p) => p.img);

---

<div class="visor" data-visor>
  <!-- Reposo -->
  <div class="vista activa" data-vista="reposo">
    <div class="texto">
      {/* El único antetítulo que queda en el panel, y es el de la sección
          —«Cotización»—, no el de una respuesta. Las vistas de respuesta
          llevaban uno cada una —«Lo que levantamos», «Lo que despachamos»—
          y se quitaron: nombraban la opción que el visitante tiene bajo el
          cursor, que es la que hizo aparecer el dibujo. */}
      {rotulo && <p class="rotulo">{rotulo}</p>}
      {/* Dos ramas con etiqueta literal y no una variable `<Titulo>`: Astro
          acota los estilos añadiendo un atributo a cada elemento que ve escrito,
          y una etiqueta dinámica la trata como componente y se queda sin él —el
          titular perdería su estilo entero—. */}
      {titular
        ? <h1 data-revelar-texto set:html={titulo} />
        : <h2 data-revelar-texto set:html={titulo} />}

      {/* El filete va SOLO donde el reposo es palabra sola. Donde hay recortes
          de catálogo la celda ya la ocupa la galería, y la condición es la
          misma que la del cuerpo de letra de más abajo —`piezas` es lo que
          pone el `[data-piezas]` que mira el CSS—, así que las dos no pueden
          discrepar. */}
      {piezas.length === 0 && (
        <div class="dibujo guadual" aria-hidden="true"><Guadual /></div>
      )}
    </div>

    <!-- EN LA MISMA CELDA QUE EL TEXTO, no debajo: mientras el cursor está
         sobre una opción, la pieza —o el mapa— OCUPA EL SITIO DEL TITULAR y el
         titular se apaga.

         Apilados, el panel no tiene que reservar alto para las dos cosas a la
         vez: la imagen dispone de la columna entera y el titular no queda
         empujado contra el techo. Debajo, cada uno se quedaba con la mitad y
         ninguno de los dos respiraba.

         Van sin pie: el botón que el visitante está señalando ya dice el
         nombre, y la medida se pregunta dos pasos más adelante. Repetirlas aquí
         era leer en voz alta lo que la mano ya está tocando. -->
    {(piezas.length > 0 || mapa) && (
      <div class="escena" aria-hidden="true">
        {piezas.length > 0 && (
          <div class="piezas" data-piezas>
            {piezas.map((p) => (
              <figure class="pieza" data-pieza={p.slug}>
                <Image src={p.img!} alt="" widths={[380, 760]} sizes="380px" loading="lazy" />
              </figure>
            ))}
          </div>
        )}

        {/* El mapa se enciende entero al llegar al paso del despacho y por
            dentro señala un municipio. Ese doble estado es `.activa` en el
            envoltorio y `data-zona` en él mismo. */}
        {mapa && <div class="mapa" data-mapa><SurHuila /></div>}

        {/* El calendario. Mismo doble estado que el mapa: `.activa` en el
            envoltorio dice si está, `data-tramo` dice cuál. */}
        {calendario && (
          <div class="calendario" data-calendario data-tramos={JSON.stringify(TRAMOS)}>
            {/* Mismo viewBox que los dibujos de gubia: el panel lo escala
                igual que al mapa y las tres respuestas ocupan la columna
                entera, sin que una parezca una miniatura al lado de otra. */}
            <svg viewBox="0 0 420 260" fill="none">
              {Array.from({ length: SEMANAS }, (_, i) => {
                const n = i + 1;
                const x = 10 + i * 34;
                return (
                  <g class="semana" data-semana={n}>
                    {/* Siete días: una semana es una semana, y con cinco el
                        dibujo se leía como una hoja de cálculo. */}
                    {Array.from({ length: 7 }, (_, d) => (
                      <rect class="dia" x={x} y={54 + d * 26} width={28} height={20} rx="3" />
                    ))}
                    <text class="num" x={x + 14} y={34} text-anchor="middle">{n}</text>
                  </g>
                );
              })}
              {[0, 1, 2].map((m) => (
                <g class="mes">
                  <line x1={10 + m * 136} y1="44" x2={140 + m * 136} y2="44" />
                  <text x={10 + m * 136} y={254}>{`MES ${m + 1}`}</text>
                </g>
              ))}
            </svg>
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Comprar guadua -->
  {muestra('suministro') && (
  <div class="vista" data-vista="suministro" aria-hidden="true">
    <div class="dibujo"><Atado /></div>
  </div>
  )}

  <!-- Diseño y construcción -->
  {muestra('construccion') && (
  <div class="vista" data-vista="construccion" aria-hidden="true">
    {/* Dibujo y no fotografía: la pregunta se contesta antes de decidir, y una
        obra concreta invita a compararse con ella en vez de a reconocerse. El
        pórtico dice qué se levanta sin decir cuál. Va tallado con la gubia del
        isotipo —crema sobre el fondo, ancho variable, puntas afiladas— para
        que se lea como marca y no como icono comprado. */}
    <div class="dibujo"><Portico /></div>
  </div>
  )}

  <!-- Revisión — tres detalles, no una escala. -->
  {muestra('anclaje') && (
  <div class="vista" data-vista="anclaje" aria-hidden="true">
    <div class="dibujo"><Anclaje /></div>
  </div>
  )}

  {muestra('inmunizado') && (
  <div class="vista" data-vista="inmunizado" aria-hidden="true">
    <div class="dibujo"><Inmunizado /></div>
  </div>
  )}

  {muestra('reemplazo') && (
  <div class="vista" data-vista="reemplazo" aria-hidden="true">
    <div class="dibujo"><Reemplazo /></div>
  </div>
  )}

  <!-- Tamaño — la misma planta con más vanos.

       Lo que cambia de una lámina a otra son los apoyos y las crujías, no los
       metros: el botón que el visitante está señalando ya trae el rango
       escrito. Es la misma razón por la que ninguna vista lleva ya texto al
       pie —ver `.vista` en los estilos—. -->
  {muestra('area-chica') && (
  <div class="vista" data-vista="area-chica" aria-hidden="true">
    <div class="dibujo"><AreaChica /></div>
  </div>
  )}

  {muestra('area-media') && (
  <div class="vista" data-vista="area-media" aria-hidden="true">
    <div class="dibujo"><AreaMedia /></div>
  </div>
  )}

  {muestra('area-grande') && (
  <div class="vista" data-vista="area-grande" aria-hidden="true">
    <div class="dibujo"><AreaGrande /></div>
  </div>
  )}

  <!-- Cantidad — las tres primeras son el mismo montón creciendo. -->
  {muestra('pocas') && (
  <div class="vista" data-vista="pocas" aria-hidden="true">
    <div class="dibujo"><Pocas /></div>
  </div>
  )}

  {muestra('media') && (
  <div class="vista" data-vista="media" aria-hidden="true">
    <div class="dibujo"><Media /></div>
  </div>
  )}

  {muestra('muchas') && (
  <div class="vista" data-vista="muchas" aria-hidden="true">
    <div class="dibujo"><Muchas /></div>
  </div>
  )}

  {muestra('calculo') && (
  <div class="vista" data-vista="calculo" aria-hidden="true">
    <div class="dibujo"><Calculo /></div>
  </div>
  )}

  <!-- Asesoría -->
  {muestra('asesoria') && (
  <div class="vista" data-vista="asesoria" aria-hidden="true">
    {/* Único de los tres con llamadas: «asesoría» no se contesta con una obra
        ni con un material, sino con un detalle. Las letras del dibujo y las de
        la lista son las mismas y en el mismo orden — si dejaran de coincidir,
        las letras pasarían a ser decoración. */}
    <div class="dibujo"><Union /></div>
    <ol class="lista-asesoria">
      <li><b>Si la boca de pescado asienta</b> o si la pieza trabaja al aire.</li>
      <li><b>Contra qué apoya el perno</b>: el entrenudo relleno o la pared sola.</li>
      <li><b>Si el entrenudo tiene mortero</b> o quedó hueco al montarlo.</li>
    </ol>
  </div>
  )}
</div>

<style>
  /* Las vistas se apilan: la altura la fija la más alta y nada salta al
     cambiar.

     `height: 100%` para que el panel pueda entregarle la altura de su fila y
     la escena reparta lo que sobre —ver `.escena`—. Donde el panel no tiene
     altura propia (el modo construir) esto se resuelve como `auto` y no hace
     nada. */
  .visor { position: relative; display: grid; height: 100%; min-height: 0; }
  /* LA RESPUESTA VA CENTRADA EN LA COLUMNA Y SIN TEXTO AL PIE.
     Cada vista llevaba un apunte de una línea debajo del dibujo, y decían lo
     que el botón que el visitante está señalando ya dice: el nombre de la
     pieza, el rango de metros, qué se revisa. Leerle en voz alta lo que tiene
     bajo la mano no informa, compite con el formulario.

     Sin ese renglón la columna entera es del dibujo, así que se centra contra
     el formulario en vez de colgar del techo: `align-content` y no
     `align-items`, porque lo que hay que centrar es el bloque de filas —rótulo
     y dibujo— y no cada fila dentro de la suya.

     EXCEPTO EL REPOSO, que se excluye a propósito: allí el bloque de texto se
     ancla arriba y el guadual se descuelga al pie, cada uno con su regla.

     Y sin tocar el eje horizontal: las filas se estiran a lo ancho de la
     columna, que es lo que permite que el dibujo la ocupe entera. Con
     `justify-items: start` —que estuvo un momento— la caja del dibujo se
     encogía a su tamaño intrínseco, el del viewBox, y la lámina se quedaba en
     420 px de los 560 disponibles con el resto en aire. */
  .vista {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }
  .vista:not([data-vista='reposo']) {
    display: grid;
    /* ANCLADA ARRIBA, NO CENTRADA, y el resultado es que queda centrada
       CONTRA LO QUE IMPORTA. La columna del panel se estira a la fila entera y
       la tarjeta del formulario mide lo que mide su contenido, así que centrar
       en la columna dejaba el dibujo más bajo que la tarjeta: dos centros que
       no coinciden, y el ojo compara los bloques, no las cajas.

       Anclando las dos al techo de la fila —la tarjeta ya lo está— y siendo el
       dibujo casi tan alto como ella, los centros caen juntos solos. Es más
       estable que un centrado con sesgo: no depende de un número que haya que
       recalcular cada vez que cambie el alto de la tarjeta, y en el paso de la
       cantidad —seis botones, columna mucho más alta— sigue cayendo donde debe
       en vez de hundirse otro palmo. */
    align-content: start;
  }
  .vista.activa { opacity: 1; pointer-events: auto; visibility: visible; }
  /* El reposo apila texto y escena en UNA celda, como las vistas se apilan
     entre sí. Es lo que permite que la imagen releve al titular en vez de
     sumarse debajo de él. */
  .vista[data-vista='reposo'] { position: relative; display: grid; grid-template-rows: 1fr; min-height: 0; }
  .texto {
    grid-area: 1 / 1;
    align-self: start;
    transition: opacity 0.28s ease;
  }
  /* EL PANEL DE OBRA: TITULAR ARRIBA Y GUADUAL DEBAJO.
     Aquí el reposo es palabra y dibujo —no hay recortes de catálogo—, y la
     columna la estira el formulario de al lado, que a partir del tercer paso
     mide seis botones. El texto se ancla arriba y el guadual crece hacia
     abajo hasta el pie de la columna: es lo que llena el hueco que antes
     dejaba el titular solo, y de paso el titular queda a la altura del
     enunciado de la pregunta, que es con quien se lee en pareja.
     El bloque se estira entero —`1fr` sobre la celda— para que el dibujo
     tenga contra qué apoyar su `margin-top: auto`. */
  .visor:not(:has([data-piezas])) .texto {
    align-self: stretch;
    display: grid;
    grid-template-rows: auto auto 1fr;
  }
  /* El titular se retira mientras hay algo señalado. No se oculta con
     `visibility` ni se saca del flujo: sigue ocupando su celda —de la que la
     escena también dispone— así que nada se recoloca al encenderse ni al
     apagarse. */
  .visor:has(.pieza.activa) .texto,
  .visor:has(.mapa.activa) .texto,
  .visor:has(.calendario.activa) .texto { opacity: 0; }

  /* `h1` y `h2` comparten estilo: cuál de los dos se emite lo decide `titular`
     —ver la nota de la propiedad—, y el nivel es información para el navegador,
     no un tamaño distinto en pantalla. */
  h1, h2 { margin-block: var(--e2) var(--e3); visibility: hidden; }
  h2 { font-size: var(--t-2xl); }
  /* `balance` y no `pretty`: el titular son dos o tres renglones y lo que se
     nota es un renglón último de dos palabras, no la viuda de un párrafo. */
  .visor:not(:has([data-piezas])) h2 {
    font-size: clamp(2.5rem, 4.2vw, 3.9rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  /* EL `h1` ES EL TITULAR DE UNA PORTADA, y mide lo que mide un titular de
     portada: el mismo clamp literal de Hero.astro, no uno parecido.

     Solo se emite cuando `titular` es cierto, es decir cuando este panel ES la
     portada de un modo —hoy, el de comprar—. Las dos reglas de arriba, que lo
     bajan a `--t-2xl` con recortes de catálogo y lo suben sin ellos, son para
     el panel-sección y siguen valiendo para el `h2`; al `h1` no le sirven,
     porque al cruzar de modo su titular es el hermano del de obra y encogía a
     la mitad. Se escribe aquí y no en HeroCompra porque las reglas de arriba
     valen (0,2,1) y una desde fuera empataría: el desempate lo decidiría el
     orden en que Astro emite las hojas, que no es nuestro.

     UN ESCALÓN POR DEBAJO DEL DE OBRA, y ya no el mismo literal. La regla
     anterior —copiar el clamp de Hero.astro— daba por hecho que los dos
     titulares miden lo mismo porque están puestos en la misma caja, y no es
     así: «Construimos con guadua» son tres palabras y «Cuéntanos qué
     necesitas y comenzamos hoy» son seis. Al mismo cuerpo, este se iba a
     cuatro renglones, se pasaba de la fila del panel y se metía por debajo
     del conmutador.

     El escalón es del 7 % (4.05rem → 3.75rem). No se lee como jerarquía —al
     cruzar de modo el titular sigue pesando lo que pesaba, que es lo que
     sostiene la lectura del cruce como desplazamiento— y a cambio la frase
     larga entra en tres renglones. Si en Hero.astro se toca el cuerpo, aquí
     se mueve el mismo escalón, no el mismo número. */
  /* Un solo cuerpo para toda pantalla, como el de obra y por lo mismo: el
     titular no puede cambiar de tamaño al pasar a pantalla completa. Estos
     eran los números de la rama de ventana baja. Sigue un escalón por debajo
     del de Hero.astro. */
  h1 {
    font-size: clamp(1.9rem, 4.05vw, 3.35rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  h1 :global(em), h2 :global(em) {
    font-family: var(--acento-tipo);
    font-style: italic;
    font-weight: 400;
    color: var(--cruda);
  }

  /* La numeración va en verde oliva porque es índice —estructura—, no acción.
     `list-style` con `lower-alpha` y no letras escritas a mano: si mañana entra
     un cuarto renglón, la lista y el dibujo se desincronizan a la vista y eso
     es justo lo que hay que notar. */
  .lista-asesoria {
    display: grid;
    gap: var(--e2);
    margin-top: var(--e3);
    max-width: 38ch;
    list-style: lower-alpha;
    padding-left: var(--e3);
  }
  .lista-asesoria li {
    padding-left: var(--e1);
    color: var(--tx3);
    font-size: var(--t-sm);
  }
  .lista-asesoria li::marker {
    font-family: var(--mono);
    color: var(--estructura);
  }
  .lista-asesoria b { color: var(--tx2); font-weight: 600; }

  /* El dibujo hereda el color del texto: es un vaciado de la misma plancha,
     no una imagen con su propia paleta. Al 82% se asienta detrás del titular
     en vez de competir con el formulario. */
  .dibujo { margin-top: var(--e3); color: var(--tx); opacity: 0.82; }
  /* --- EL GUADUAL ------------------------------------------------------
   *
   * Se descuelga al pie de la columna —`margin-top: auto` contra la fila
   * `1fr` de `.texto`— en vez de ir pegado al titular: el aire entre los dos
   * es lo que hace que se lea como un paisaje al fondo y no como un adorno
   * colgado del último renglón.
   *
   * Al 0.5 y en `--cruda`: el guadual es dato de material, no acción ni
   * estructura —ver el manual de color en CLAUDE.md—, y por encima de eso le
   * disputa la mirada al formulario, que es lo que hay que pulsar.
   *
   * Hereda del `.dibujo` la mecánica de tallado y, con ella, el
   * `display: none` de celular: allí el visor se queda en su titular.
   */
  .guadual {
    margin-top: auto;
    align-self: end;
    color: var(--cruda);
    /* MÁS TRANSPARENTE QUE UNA LÁMINA DE RESPUESTA (0.82) porque no es una
       lámina: es fondo. Al 0.5 se leía como un dibujo puesto encima de la
       fotografía del guadual; al 0.38 se mete dentro de ella y el titular
       recupera el primer plano, que es de quien tiene que ser.

       Este número y el de `.lejos` son la pareja que gradúa el dibujo: este
       manda cuánto pesa el guadual entero contra el fondo, aquel cuánta
       profundidad hay entre sus dos planos. */
    opacity: 0.38;

    /* CRUZA LA COLUMNA DE LADO A LADO. Encajado en su columna, el guadual se
       leía como una lámina pegada en un recuadro. Ahora arranca en el borde
       izquierdo de la página —no en el margen del texto— y muere un poco
       antes del formulario, comiéndose además el relleno inferior de la
       sección, así que solo uno de sus cuatro lados coincide con algo.

       `--sangria` rehace la cuenta de `--nudo-margen` con `100vw` en vez de
       `100%`: la de `.nudo` está escrita para medirse contra el ancho de la
       sección y aquí se resolvería contra el ancho de este div. El sobrante
       de la barra de desplazamiento —`100vw` la ignora— lo recorta el
       `overflow: hidden` de la sección, que es donde se apoya todo esto. */
    --sangria: max(var(--gutter), calc((100vw - var(--ancho)) / 2 + var(--gutter)));
    width: calc(100% + var(--sangria) + var(--e5) / 2);
    margin-left: calc(var(--sangria) * -1);
    margin-right: calc(var(--e5) / -2);
    margin-bottom: calc(var(--e6) * -1);

    /* Y EL FINAL LO PONE UNA MÁSCARA, no el borde de la caja. Arriba se
       desvanece en el 16% —lo justo para que el guadual no choque contra el
       titular; más fundido y se comía las puntas arqueadas, que son las que
       ocupan ese hueco—. A la derecha se apaga en el último 10%, ya contra el
       formulario.

       A la izquierda NO hay desvanecido, y es deliberado: ahí el dibujo llega
       al borde de la pantalla, donde un corte no es un corte sino el final de
       la página. Abajo tampoco, por lo mismo: se sale de la sección.

       LOS DOS DESVANECIDOS VAN EN ELEMENTOS DISTINTOS —el vertical aquí, el
       horizontal en el `<svg>` de dentro— y no como dos capas de un mismo
       `mask-image`. Apiladas hacían falta `mask-composite: intersect` y su
       gemela `-webkit-mask-composite`, y las dos juntas no componen igual: el
       resultado medido era un guadual recortado a un tercio de su ancho, sin
       que ninguna de las dos reglas pareciera tener la culpa. Anidando, cada
       máscara es de un elemento, se aplican una tras otra y no hay compuesto
       que discutir.

       Es máscara y no un degradado encima: el fondo de la sección es el
       guadual fotográfico y una capa de color sólido por delante se notaría
       como una mancha rectangular en cuanto la foto cambie de tono. */
    mask-image: linear-gradient(to bottom, transparent, #000 16%);

    /* SE ESTIRA A TODO EL HUECO LIBRE. La fila `1fr` de `.texto` es lo que
       queda de la columna por debajo del titular; el guadual la toma entera y
       el `slice` de su `preserveAspectRatio` se encarga de cubrirla recortando
       por arriba y por la derecha, en vez de dejar franjas vacías.

       MÁS ALTO QUE SU FILA, no solo con margen negativo debajo. Con
       `height: 100%` el dibujo medía exactamente la fila libre y el margen
       negativo no lo estiraba —no hay nada detrás a lo que ganarle sitio—, así
       que las cañas terminaban un palmo por encima del borde de la sección,
       justo el relleno `--e6`. Sumándoselo al alto, el dibujo entra en ese
       relleno y lo recorta el `overflow: hidden` de la sección. */
    height: calc(100% + var(--e6));
    /* Suelo por si la columna del formulario es corta —el primer paso son tres
       botones— y no por proporción del dibujo: con `slice` el guadual cubre
       cualquier caja, pero por debajo de esto no cabe una caña entera. */
    min-height: 20rem;
  }
  .guadual :global(svg) {
    max-width: none;
    width: 100%;
    /* El relleno inferior de la sección, de propina: el dibujo se mete en él y
       lo recorta el `overflow: hidden` de la sección, así que las cañas mueren
       en el borde de la página y no un palmo antes. */
    height: calc(100% + var(--e6));
    mask-image: linear-gradient(to right, #000 90%, transparent);
  }

  /* EL GUADUAL SE REVELA DE UNA PIEZA, NO GUBIA A GUBIA.
   *
   * Es la única lámina del sitio que no se talla trazo a trazo, y la excepción
   * está ganada. Se probaron cinco repartos —por planos, de izquierda a
   * derecha, por manchas, mata a mata y creciendo de abajo arriba— y todos
   * compartían el mismo defecto: ochocientos trazos escalonados son
   * ochocientos sucesos, y por bien ordenados que estén el ojo sigue el
   * reparto en vez de mirar el bosque. Las otras once láminas SON la pieza que
   * enseñan, así que verlas construirse es el contenido; un guadual no es una
   * pieza que se arma a la vista, es un sitio que ya estaba.
   *
   * Por eso el escalonado se quitó del generador y no se dejó apagado aquí: el
   * `--i` de estos 815 trazos no lo mira nadie, y la coreografía entera cabe
   * en las cuatro líneas de abajo.
   *
   * El gesto es UNO y dura 1,5 s: el guadual se alza. Sube un 4% de su alto,
   * se despliega desde el pie —`transform-origin` abajo, que es donde nacen
   * las cañas— y aparece. El `scaleY` de 0,94 es lo que lo hace orgánico: no
   * es un bloque que entra desde abajo, es un guadual que se estira. La curva
   * arranca deprisa y frena muy largo, que es la forma de que 1,5 s se sientan
   * como un despliegue y no como una espera.
   *
   * Va en el `<svg>` y no en el `.guadual`: el div lleva la opacidad de fondo
   * (0.38) y el desvanecido de arriba, y animar su opacidad los pisaría.
   */
  .vista.activa .guadual :global(.gu) { animation: none; }
  .vista.activa .guadual :global(svg) {
    transform-origin: 0 100%;
    animation: alzar-guadual 1.5s cubic-bezier(0.16, 0.88, 0.22, 1) both;
  }
  @keyframes alzar-guadual {
    from { opacity: 0; transform: translateY(4%) scaleY(0.94); }
    to   { opacity: 1; transform: none; }
  }

  /* --- EL VIENTO -------------------------------------------------------
   *
   * Cada caña va envuelta en un `<g class="viento">` con su origen de giro al
   * pie, su amplitud, su periodo y su desfase —los emite `gubia.py`—, y las
   * ramas van en otro grupo dentro del suyo: la hoja bate más rápido que el
   * culmo que la sostiene, y anidar es la única forma de sumar dos
   * movimientos, porque dos animaciones sobre el mismo elemento se pisan.
   *
   * `alternate` y no un ciclo entero: una caña vuelve por donde fue. Y los
   * desfases son NEGATIVOS, así que al llegar la sección el guadual ya está
   * mecido a media carrera en vez de arrancar todo el bosque desde el mismo
   * punto muerto.
   *
   * Solo `transform`, como el resto del sitio: nada aquí toca layout.
   */
  .guadual :global(.viento) {
    transform-box: view-box;
    transform-origin: var(--ox) var(--oy);
    animation: mecer var(--dur) ease-in-out var(--ret) infinite alternate;
  }
  @keyframes mecer {
    from { transform: rotate(calc(var(--amp) * -0.55)); }
    to   { transform: rotate(var(--amp)); }
  }
  /* El fondo, mucho más pálido: es lo que separa los tres planos. El trazo ya
     es más fino, pero solo con eso las cañas de atrás se leían a la misma
     distancia que las de delante. El contraste es lo único que queda para
     decir cuál está detrás, ahora que ninguna se inclina.

     Se multiplica por el 0.38 del padre, así que el fondo queda al 0.13 real:
     por debajo de eso desaparece sobre la fotografía y el guadual pierde su
     espesura. */
  .guadual :global(.lejos) { opacity: 0.34; }
  /* `:not(.guadual)` Y NO CONFIAR EN EL ORDEN. Esta regla vive más abajo en la
     hoja que la del guadual y tiene su misma especificidad, así que su
     `max-width: 420px` ganaba y recortaba el bosque a 420 px de ancho justos
     —con su `height: auto` de propina, que anulaba el estirado—. El síntoma
     era un guadual que se acababa a media columna y una franja vacía a la
     derecha, y no había nada en el bloque del guadual que lo explicara.
     Excluirlo aquí lo arregla en el sitio donde está la causa, y no queda
     colgando de que nadie mueva un bloque de sitio. */
  /* SIN TOPE DE ANCHO: la lámina ocupa la columna entera. Tuvo uno de 420 px
     —el ancho de su propio viewBox— de cuando compartía sitio con un apunte y
     con el titular; ahora la columna es solo suya y ese tope dejaba un tercio
     en aire. El viewBox no manda el tamaño de pintado, solo la proporción.

     Las gubias aguantan la ampliación porque están dibujadas para el tamaño
     MÁS PEQUEÑO en que se usan —ninguna baja de 3 unidades de ancho, que es la
     regla que ya seguía el pórtico para verse a la mitad en las tarjetas de
     servicios—: un trazo grueso escala hacia arriba sin romperse, al revés no.

     El tamaño lo manda el ANCHO y nada más. Un `max-height` parecía prudente
     —la columna se estira cuando el formulario mide seis botones— y sobra: la
     lámina crece con su columna, que es la mitad de la página, y nunca se pasa
     de alto. Y habría hecho daño: al topar el alto, un SVG con `viewBox` no se
     recorta, se encoge dentro de su caja y deja franjas a los lados, que es
     justo el aire que estamos quitando. */
  .dibujo:not(.guadual) :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  /* --- El tallado ---------------------------------------------------- *
   *
   * Cada gubia se escala en su propia dirección desde el punto donde entra
   * el filo: el trazo *avanza* por la plancha en vez de aparecer. Eso es lo
   * que separa esto de un fundido —y es el motivo de que el generador emita
   * `--x`, `--y` y `--a` por trazo en vez de un path suelto.
   *
   * Arranca cuando la vista se vuelve `.activa`, no al entrar en pantalla:
   * la respuesta se talla cada vez que el visitante pasa por la opción, que
   * es cuando la pregunta está viva. Volver a poner la animación en un
   * elemento que ya la corrió exige que el navegador la reinicie, y lo hace
   * porque la clase entra y sale con el foco.
   *
   * Solo `transform`: nada aquí toca layout.
   */
  .vista.activa .dibujo :global(.gu) {
    transform-box: view-box;
    transform-origin: var(--x, 50%) var(--y, 50%);
    animation: tallar 0.34s cubic-bezier(0.3, 0.9, 0.4, 1) backwards;
    /* 22 ms por trazo: con ~40 gubias el dibujo se cierra en menos de un
       segundo, que es lo que dura la mirada antes de volver al formulario. */
    animation-delay: calc(var(--i) * 22ms);
  }
  /* Una masa no se abre con el filo: se entinta de golpe. */
  .vista.activa .dibujo :global(.gu.masa) { animation-name: entintar; }

  @keyframes tallar {
    from { transform: rotate(var(--a)) scaleX(0) rotate(calc(-1 * var(--a))); }
    to   { transform: rotate(var(--a)) scaleX(1) rotate(calc(-1 * var(--a))); }
  }
  @keyframes entintar {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* Las cinco piezas comparten celda; el alto lo fija la más alta y ninguna
     empuja el texto al entrar. */
  /* La celda donde el panel contesta: los recortes de catálogo en el paso de
     la pieza y el mapa en el de despacho, apilados y nunca a la vez. El alto
     lo fija la escena y no su contenido —alto fijo, no mínimo—: con
     `min-height` lo primero que entra estira la celda y empuja media página
     hacia abajo justo cuando el visitante está apuntando a un botón. */
  /* LA ESCENA OCUPA LA CELDA ENTERA, la misma que el texto.
     Sin alto propio y sin tope: lo que mide es lo que mida el panel, que ya
     viene ajustado a su fila. Antes reservaba una banda fija debajo del texto
     y había que repartir el alto entre los dos; ahora se turnan.

     `min-height: 0` y `overflow: hidden` para que el contenido no imponga su
     alto intrínseco hacia arriba: el tamaño mínimo automático de un ítem de
     rejilla es el de su contenido, y sin esto una foto de 300 px volvería a
     estirar la fila —y con ella el panel, la portada y el conmutador—. */
  /* FUERA DEL FLUJO, no solo apilada. `grid-area` la ponía en la misma celda
     que el texto, pero seguía contando para medir la fila: una pista `1fr` en
     dimensionado intrínseco toma el MAX-CONTENT de sus ítems, y el max-content
     de una foto es su alto natural —545 px la rolliza—, que ni `min-height: 0`
     ni `overflow: hidden` recortan. El panel crecía a 545, la portada de compra
     se estiraba 119 px por debajo de la de obra y el conmutador se descolgaba.

     En absoluto no mide nada y ocupa todo: el panel lo dimensiona el titular
     —y la fila, el formulario— y la escena se queda con ese rectángulo, sea
     cual sea. */
  .escena {
    position: absolute;
    inset: 0;
    display: grid;
    overflow: hidden;
  }
  .piezas { grid-area: 1 / 1; display: grid; height: 100%; min-height: 0; }
  /* Recortes y mapa comparten celda Y encuadre: los dos centrados en el alto
     y arrimados al margen izquierdo. Estaban en ejes distintos —la foto
     apoyada abajo, el mapa centrado— y al pasar del paso de la pieza al del
     despacho el contenido daba un salto vertical que se leía como un
     desajuste, no como un cambio de contenido. */
  .pieza {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    align-self: center;
    justify-self: start;
  }
  .pieza.activa { opacity: 1; visibility: visible; }
  .pieza :global(img) {
    display: block;
    width: auto;
    max-width: min(380px, 100%);
    /* El recorte se acomoda al alto de la celda: la esterilla es apaisada y la
       rolliza vertical, y las dos tienen que caber sin cambiarlo. Al alto de
       la celda, no a un número: la escena ya no mide siempre lo mismo. */
    max-height: 100%;
    height: auto;
    object-fit: contain;
  }

  /* --- EL MAPA DE DESPACHO ---------------------------------------------
   *
   * Geografía real —límites del DANE vía geoBoundaries, ver
   * `herramientas/mapa-despacho.py`— dibujada con la línea del sitio. Los
   * municipios vecinos van de marco: sin ellos las cuatro zonas flotan y no se
   * lee que son un bloque contiguo.
   *
   * El mapa entero aparece al apuntar cualquier opción del paso; cuál se
   * enciende lo dice `data-zona` en el mismo elemento. Dos estados separados a
   * propósito: el municipio cambia mucho más seguido que el mapa, y así ese
   * cambio no vuelve a montar nada.
   */
  .mapa {
    grid-area: 1 / 1;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    /* Ocupa la celda entera —la misma de la que dispone el titular— en vez de
       arrimarse a una esquina con un ancho tope. */
    align-self: stretch;
    justify-self: stretch;
  }
  .mapa.activa { opacity: 1; visibility: visible; }
  /* Al 100% en los dos ejes y que encaje solo: un SVG con `viewBox` y el
     `preserveAspectRatio` de serie se ajusta dentro de su caja sin deformarse,
     así que el mapa siempre sale tan grande como el panel permita —y sigue
     entero— sin tener que fijar aquí ningún número. */
  .mapa :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Reposo del mapa: es un dato, no una acción. Todo en café guadua, y la
     diferencia entre «zona que atendemos» y «vecino que solo enmarca» está en
     el relleno, no en el color. */
  .mapa :global(.mun) {
    fill: none;
    stroke: var(--cruda);
    stroke-width: 0.8;
    opacity: 0.35;
    transition: fill 0.25s ease, opacity 0.25s ease;
  }
  .mapa :global(.zona) { fill: var(--cruda); fill-opacity: 0.12; opacity: 0.6; }

  .mapa :global(.punto) { transition: opacity 0.25s ease; opacity: 0.45; }
  .mapa :global(.pin) { fill: var(--cruda); }
  .mapa :global(.halo) { fill: none; transition: fill 0.25s ease; }
  /* Los nombres empiezan apagados y los enciende el estado, uno a la vez.
     Con los cuatro puestos el mapa es una lista de municipios que ya está
     ahí al lado en botones, y encima San Agustín e Isnos quedan tan juntos
     que sus rótulos se pisan. */
  .mapa :global(.punto text) {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    fill: var(--tx3);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  /* EL MUNICIPIO SEÑALADO. Naranja porque es la respuesta a lo que el cursor
     está pidiendo —acción—, mientras el resto del mapa sigue siendo dato en
     café guadua. Y el resto no solo se queda quieto: se retira al 16 %, que es
     lo que convierte «uno más encendido» en «uno, y los demás de fondo».

     Cuál está encendido lo marca `motion.ts` con la clase `.activa`, no una
     lista de municipios escrita aquí: así el día que entre un quinto pueblo no
     hay que acordarse de este archivo. «Otro municipio» enciende el mapa sin
     encender nada dentro —no hay punto que señalar— y el efecto es el correcto
     por sí solo: la zona entera se retira, que es justo lo que significa. */
  .mapa[data-zona] :global(.mun:not(.activa)) { opacity: 0.16; }
  .mapa :global(.mun.activa) {
    opacity: 1;
    fill: var(--accion);
    fill-opacity: 0.16;
    stroke: var(--accion-tx);
    stroke-width: 1.3;
  }

  .mapa[data-zona] :global(.punto:not(.activa)) { opacity: 0.22; }
  .mapa :global(.punto.activa) { opacity: 1; }
  .mapa :global(.punto.activa .pin) { fill: var(--accion-tx); }
  /* El halo solo existe encendido: es el pulso del punto que contesta. */
  .mapa :global(.punto.activa .halo) {
    fill: var(--accion);
    fill-opacity: 0.22;
  }
  .mapa :global(.punto.activa text) { opacity: 1; fill: var(--tx); }

  /* --- EL CALENDARIO ----------------------------------------------------
   *
   * Mismo lenguaje que el mapa, que es lo que hace que las dos respuestas del
   * panel se lean como la misma familia: el dato en café guadua, lo señalado en
   * naranja, y lo demás retirándose para que «uno encendido» no dependa solo de
   * que ese brille más.
   *
   * Doce columnas de cinco días. Los días son rectángulos y no puntos porque a
   * este tamaño un círculo de 8 px se lee como grano de textura; un rectángulo
   * con esquina blanda se lee como casilla, que es lo que hace calendario a un
   * calendario.
   */
  .calendario {
    grid-area: 1 / 1;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    align-self: stretch;
    justify-self: stretch;
    overflow: hidden;
  }
  .calendario.activa { opacity: 1; visibility: visible; }
  .calendario svg { display: block; width: 100%; height: 100%; }

  .calendario :global(.dia) {
    fill: var(--cruda);
    fill-opacity: 0.14;
    stroke: var(--cruda);
    stroke-width: 0.9;
    /* Sobre la fotografía del acopio, con menos filo la rejilla se disolvía y
       dejaba de leerse como calendario: quedaban tres columnas naranjas
       flotando sobre unas guaduas. */
    stroke-opacity: 0.55;
    transition: fill-opacity 0.25s ease, stroke 0.25s ease, opacity 0.25s ease;
  }
  .calendario :global(.mes line) { stroke: var(--estructura); stroke-width: 2; }
  .calendario :global(.mes text) {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.14em;
    fill: var(--tx4);
  }
  /* El número de semana solo aparece sobre la encendida: los doce puestos son
     una fila de cifras que nadie lee y que compite con la pregunta. */
  .calendario :global(.num) {
    font-family: var(--mono);
    font-size: 13px;
    fill: var(--tx3);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  /* Con un tramo pedido, lo que no está en él se retira. */
  .calendario[data-tramo] :global(.semana:not(.activa) .dia) { opacity: 0.16; }
  /* El relleno va en `--accion-tx` y no en `--accion`: el naranja pleno sobre
     fondo oscuro y a media opacidad se apaga a marrón, y a este tamaño de
     casilla el que hace el trabajo es el filo. Es el mismo reparto que en el
     mapa —poco relleno, borde claro— para que las dos respuestas del panel se
     enciendan igual. */
  .calendario :global(.semana.activa .dia) {
    fill: var(--accion-tx);
    fill-opacity: 0.28;
    stroke: var(--accion-tx);
    stroke-opacity: 1;
    stroke-width: 1.4;
  }
  .calendario :global(.semana.activa .num) { opacity: 1; fill: var(--accion-tx); }

  /* --- PANEL DE COMPRA: EL TITULAR SOLO --------------------------------
   *
   * Donde hay recortes de catálogo —solo el modo comprar— el reposo es un
   * titular grande y nada más: ni antetítulo ni bajada. El formulario está al
   * lado contándose solo, con su enunciado y su contador de pasos, así que el
   * párrafo repetía en prosa lo que la tarjeta ya enseña y le disputaba la
   * mirada al titular.
   *
   * La condición es `:has([data-piezas])` y no una propiedad nueva: la galería
   * de recortes solo existe si el calificador declara vistas `pieza:`, así que
   * el panel de obra —que no las tiene— conserva su cuerpo de letra de siempre
   * sin que haya que acordarse de pasarle nada.
   */
  /* Solo el `h2`: el `h1` es el titular de una portada y su cuerpo lo fija la
     regla de arriba, la que copia el clamp de Hero.astro. Con el `h1` aquí,
     esta regla —que va después y vale lo mismo— se lo llevaba por delante. */
  .visor:has([data-piezas]) h2 {
    /* Por encima de `--t-3xl`: desde que la imagen releva al titular en vez de
       colocarse debajo, el titular tiene la columna entera para él y puede
       pesar lo que pesa el formulario de al lado. */
    font-size: clamp(2.6rem, 4.6vw, 4.2rem);
  }


  /* EN CELULAR EL VISOR SE QUEDA EN SU TEXTO.
     Dos razones, y la segunda es la que decide:

     1. Apiladas en una columna, el dibujo y la pieza —300 px de alto fijo—
        metían unos 450 px entre la bajada y el formulario. Al pulsar
        «Hablemos» el visitante aterrizaba en el titular con la primera
        pregunta por debajo del pliegue, y encima tapada por el botón
        flotante. El embudo entero empezaba con un desplazamiento a ciegas.

     2. El visor responde a `mouseenter` y a `focus` sobre las opciones: es una
        respuesta a lo que el visitante *apunta* antes de decidir. Con el dedo
        no hay apuntar —se toca y ya está—, y al tocar el paso avanza y el
        visor vuelve a reposo. En táctil nunca llega a cambiar de vista: ocupa
