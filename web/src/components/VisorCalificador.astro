    .visor:not(:has([data-piezas])) h2 { font-size: clamp(2rem, 3.3vw, 2.9rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* El dibujo entero, ya tallado, desde el primer fotograma. */
    .vista .dibujo :global(.gu) { animation: none; }
