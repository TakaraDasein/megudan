---
import { sitio } from '../data/sitio';
import Isla from './islands/Calificador';
import GuadualFondo from './texturas/GuadualFondo.astro';
import VisorCalificador from './VisorCalificador.astro';
import type { Paso } from './islands/Calificador';
import { vistasDe } from '../data/calificadores';

interface Props {
  pasos: Paso[];
  preseleccion?: Record<string, string>;
  rotulo?: string;
  titulo: string;
  /** Primera línea del mensaje si el primer paso no trae `contextos`. */
  contexto?: string;
  /** El panel es la portada del modo: su título va como `h1`. Ver VisorCalificador. */
  titular?: boolean;
}
const {
  pasos, preseleccion, rotulo = 'Cotización', titulo, contexto, titular = false,
} = Astro.props;

/* El panel va sin bajada, como el de compra: el formulario de al lado se
   cuenta solo —enunciado, botones y contador de pasos— y el párrafo repetía
   en prosa lo que la tarjeta ya enseña, disputándole la mirada al titular. */

/* El visor solo imprime las vistas que este calificador puede pedir. */
const vistas = vistasDe(pasos);
---

<!-- `canuto`: el embudo de obra es una pantalla y una idea, igual que la
     portada de compra —donde el formulario ES la portada—. Marcado así, entrar
     y salir de él es un paso bloqueado: un gesto lo trae encuadrado y otro lo
     deja.

     El bloqueo se autoprotege. `saltos` comprueba en cada momento que la
     sección CABE en la ventana antes de secuestrar la rueda, y esta no siempre
     cabe: mide 0,87 pantallas a 1440×900 pero 1,04 a 1280×720. En la ventana
     baja vuelve a leerse libre, porque encerrar a alguien dentro del embudo sin
     poder llegar al botón de enviar sería el peor fallo posible de este sitio.
     Si algún día la tarjeta adelgaza esos 40 px, el paso se activa solo. -->
<section id="calificador" class="seccion nudo canuto" data-visor-raiz data-parada>
  <GuadualFondo />

  <div class="contenedor rejilla">
    <VisorCalificador
      rotulo={rotulo}
      titulo={titulo}
      vistas={vistas}
      titular={titular}
    />

    <!-- Única isla interactiva del sitio: se hidrata al entrar en pantalla. -->
    <Isla
      client:visible
      whatsapp={sitio.whatsapp}
      pasos={pasos}
      preseleccion={preseleccion}
      contexto={contexto}
    />
  </div>
</section>

<style>
  /* QUE QUEPA EN LA VENTANA BAJA — de esto depende que sea un paso.

     `saltos` solo bloquea la rueda si la sección cabe: encerrar a alguien
     dentro del embudo sin poder llegar al botón de enviar sería el peor fallo
     de este sitio. Y sin caber no hay paso ni de ida ni de vuelta.

     Medido en Chromium: la sección ocupa 747 px en una ventana de 720, o sea
     le sobran 27. Lo que cede es AIRE, no contenido — el relleno de sección es
     `--e6`, 104 px arriba y abajo—; bajándolo a `--e5` se ahorran 80 y la
     sección cae a 667, con holgura para que el visor respire.

     Es la misma disciplina y la misma familia de consultas POR ALTURA que ya
     usan las dos portadas para caber en el portátil bajo. Y solo por encima de
     901 px de ancho, que es donde existen los pasos. */
  @media (min-width: 901px) and (max-height: 860px) {
    #calificador { padding-block: var(--e5); }
  }

  /* Segundo escalón, para el portátil de 650 de alto: con `--e5` la sección se
     quedaba en 705 y volvía a pasarse. `--e4` la deja en 619. Por debajo de
     esto la guarda de `saltos` hace su trabajo y devuelve la lectura libre: hay
     un punto en el que seguir quitando aire empieza a apretar el formulario, y
     antes de llegar ahí es mejor no bloquear la rueda. */
  @media (min-width: 901px) and (max-height: 700px) {
    #calificador { padding-block: var(--e4); }
  }


  #calificador { position: relative; overflow: hidden; }
  #calificador > .contenedor { position: relative; }

  /* Las dos columnas al mismo peso: el panel enseña una pieza construida y a
     0.85fr se quedaba en 432 px, donde los escalones del pedestal ya no se
     distinguen del disco. */
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e5);
    align-items: start;
  }
  /* SOLO EL PANEL SE ESTIRA, el formulario no. Con `align-items: start` el
     panel medía lo que mide su texto y el guadual que se descuelga de él —ver
     `.guadual` en VisorCalificador— se quedaba flotando a media sección: su
     `height: 100%` se resolvía contra esa altura corta y no contra la fila.
     Pero estirar las DOS columnas hacía crecer también la tarjeta del
     formulario, que se quedaba con un palmo de vacío bajo el último botón: una
     tarjeta mide lo que mide su contenido.

     El texto no se descoloca: dentro del panel sigue anclado arriba, porque el
     reposo reparte su celda en `auto auto 1fr`. */
  .rejilla > :first-child { align-self: stretch; }
  h2 { font-size: var(--t-2xl); margin-block: var(--e2) var(--e3); visibility: hidden; }
  h2 :global(em) {
    font-family: var(--acento-tipo);
    font-style: italic;
    font-weight: 400;
    color: var(--cruda);
  }

  @media (max-width: 900px) {
    .rejilla { grid-template-columns: 1fr; gap: var(--e4); }
  }
  @media (prefers-reduced-motion: reduce) { h2 { visibility: visible; } }
</style>
