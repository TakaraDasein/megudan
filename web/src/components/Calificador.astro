---
import { sitio } from '../data/sitio';
import Isla from './islands/Calificador';
import GuadualFondo from './texturas/GuadualFondo.astro';
import VisorCalificador from './VisorCalificador.astro';
import type { Paso } from './islands/Calificador';
import { vistasDe } from '../data/calificadores';

interface Props {
  pasos: Paso[];
  preseleccion?: Record<string, string>;
  rotulo?: string;
  titulo: string;
  /** Primera línea del mensaje si el primer paso no trae `contextos`. */
  contexto?: string;
  /** El panel es la portada del modo: su título va como `h1`. Ver VisorCalificador. */
  titular?: boolean;
}
const {
  pasos, preseleccion, rotulo = 'Cotización', titulo, contexto, titular = false,
} = Astro.props;

/* El panel va sin bajada, como el de compra: el formulario de al lado se
   cuenta solo —enunciado, botones y contador de pasos— y el párrafo repetía
   en prosa lo que la tarjeta ya enseña, disputándole la mirada al titular. */

/* El visor solo imprime las vistas que este calificador puede pedir. */
const vistas = vistasDe(pasos);
---

<section id="calificador" class="seccion nudo" data-visor-raiz>
  <GuadualFondo />

  <div class="contenedor rejilla">
    <VisorCalificador
      rotulo={rotulo}
      titulo={titulo}
      vistas={vistas}
      titular={titular}
    />

    <!-- Única isla interactiva del sitio: se hidrata al entrar en pantalla. -->
    <Isla
      client:visible
      whatsapp={sitio.whatsapp}
      pasos={pasos}
      preseleccion={preseleccion}
      contexto={contexto}
    />
  </div>
</section>

<style>
  #calificador { position: relative; overflow: hidden; }
  #calificador > .contenedor { position: relative; }

  /* Las dos columnas al mismo peso: el panel enseña una pieza construida y a
     0.85fr se quedaba en 432 px, donde los escalones del pedestal ya no se
     distinguen del disco. */
  .rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--e5);
    align-items: start;
  }
  /* SOLO EL PANEL SE ESTIRA, el formulario no. Con `align-items: start` el
     panel medía lo que mide su texto y el guadual que se descuelga de él —ver
     `.guadual` en VisorCalificador— se quedaba flotando a media sección: su
     `height: 100%` se resolvía contra esa altura corta y no contra la fila.
     Pero estirar las DOS columnas hacía crecer también la tarjeta del
     formulario, que se quedaba con un palmo de vacío bajo el último botón: una
     tarjeta mide lo que mide su contenido.

     El texto no se descoloca: dentro del panel sigue anclado arriba, porque el
     reposo reparte su celda en `auto auto 1fr`. */
  .rejilla > :first-child { align-self: stretch; }
  h2 { font-size: var(--t-2xl); margin-block: var(--e2) var(--e3); visibility: hidden; }
  h2 :global(em) {
    font-family: var(--acento-tipo);
    font-style: italic;
    font-weight: 400;
    color: var(--cruda);
  }

  @media (max-width: 900px) {
    .rejilla { grid-template-columns: 1fr; gap: var(--e4); }
  }
  @media (prefers-reduced-motion: reduce) { h2 { visibility: visible; } }
</style>
